DATABASE_URL=                 # Neon pooled connection string; app runtime
DATABASE_URL_UNPOOLED=        # Neon direct connection string; migrations and Drizzle Kit
DATABASE_DRIVER=pg            # pg (default) or neon-http where outbound Postgres (5432) is blocked
BETTER_AUTH_SECRET=           # random secret, at least 32 characters
BETTER_AUTH_URL=http://localhost:4321
SEED_CHAIR_EMAIL=             # seed script only
SEED_CHAIR_NAME=              # seed script only; defaults to Chair
SEED_CHAIR_PASSWORD=          # seed script only; at least 12 characters
METOFFICE_API_KEY=            # optional server-side weather API key
PUBLIC_MAP_API_KEY=           # optional public CARTO map key; exposed to the map island
BLOB_READ_WRITE_TOKEN=        # optional Vercel Blob token for venue image uploads
ORS_API_KEY=                  # OpenRouteService key (server-only, no PUBLIC_ prefix): venue address search, walking distance and time from HQ. OPENROUTESERVICE_API_KEY also works
