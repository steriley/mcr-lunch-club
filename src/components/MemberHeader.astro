---
/**
 * "Sign in", or the member's account link, as the last item of the site nav (#136): at the far
 * right of the nav pill on wide screens, and at the bottom of the burger menu on phones. Layout
 * renders it (once in each nav) only while the `members` flag is on; with the flag off there is
 * nothing here at all.
 *
 * Prerendered pages ship the signed-out state. The script asks /api/member/session who is signed
 * in only when the readable `signed_in` hint cookie is set (src/lib/auth-config.ts), and only once
 * for both navs, so a signed-out visitor makes no member or auth request (epic #135, "Performance
 * budget"; e2e/members.spec.ts). A Chair gets a link to the Chairs' Area instead of a member link.
 * The script is bundled, so it needs no CSP hash, and it loads no auth code.
 */
import Icon from '@/components/Icon.astro';

interface Props {
  /** Which nav it sits in: the main one (wide screens) or the burger menu (phones). */
  placement: 'main' | 'menu';
}

const { placement } = Astro.props;
---

<div class="member-nav" data-member-header={placement}>
  <a href="/members/sign-in" class="site-nav-link" data-member-signed-out>
    <Icon name="lock" class="nav-icon" />
    <span>Sign in</span>
  </a>
  <a href="/members/me" class="site-nav-link" data-member-account hidden>
    <span class="member-initial" aria-hidden="true" data-member-initial></span>
    <span class="member-name" data-member-name>
      Your account
    </span>
  </a>
  <a href="/admin" class="site-nav-link" data-member-chair hidden>
    <Icon name="landmark" class="nav-icon" />
    <span>Chairs’ Area</span>
  </a>
</div>

<style>
  .member-nav {
    display: flex;
    align-items: center;
  }

  /* In the pill: a hairline between the site's pages and the visitor's own link. */
  .member-nav[data-member-header='main'] {
    margin-left: 4px;
    padding-left: 4px;
    border-left: 1px solid var(--ledger-border);
  }

  /* In the burger menu: the last item, set off by a rule above it. */
  .member-nav[data-member-header='menu'] {
    flex-direction: column;
    align-items: stretch;
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1px solid var(--ledger-border);
  }

  .member-nav[data-state='checking'] .site-nav-link {
    visibility: hidden;
  }

  .member-nav .site-nav-link[hidden] {
    display: none;
  }

  .member-name {
    max-width: 12rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .member-initial {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-navy-fixed);
    color: var(--color-white);
    font-size: 11px;
    font-weight: 700;
  }
</style>

<script>
  const HINT = /(?:^|;\s*)signed_in=1(?:;|$)/;
  const TIMEOUT_MS = 4000;

  type MemberSession =
    { state: 'signed_out' } | { state: 'chair' } | { state: 'member'; displayName: string | null };

  async function readSession(): Promise<MemberSession | null> {
    try {
      const response = await fetch('/api/member/session', {
        credentials: 'same-origin',
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
      return response.ok ? ((await response.json()) as MemberSession) : null;
    } catch {
      return null;
    }
  }

  function show(root: HTMLElement, session: MemberSession | null) {
    const signedOut = root.querySelector<HTMLElement>('[data-member-signed-out]');
    const account = root.querySelector<HTMLElement>('[data-member-account]');
    const chair = root.querySelector<HTMLElement>('[data-member-chair]');
    if (session?.state === 'member' && account) {
      const name = session.displayName?.trim() || 'Your account';
      account.querySelector('[data-member-name]')!.textContent = name;
      account.querySelector('[data-member-initial]')!.textContent = (
        session.displayName?.trim()[0] ?? '•'
      ).toUpperCase();
      account.hidden = false;
      if (signedOut) signedOut.hidden = true;
    } else if (session?.state === 'chair' && chair) {
      chair.hidden = false;
      if (signedOut) signedOut.hidden = true;
    }
    delete root.dataset.state;
  }

  const roots = [...document.querySelectorAll<HTMLElement>('[data-member-header]')];
  if (roots.length && HINT.test(document.cookie)) {
    for (const root of roots) root.dataset.state = 'checking';
    // One request for both navs.
    void readSession().then((session) => {
      if (session?.state === 'signed_out') {
        // The server cleared the hint too; this covers a response that was cached on the way.
        document.cookie = 'signed_in=; Path=/; Max-Age=0; SameSite=Lax';
      }
      for (const root of roots) show(root, session);
    });
  }
</script>
