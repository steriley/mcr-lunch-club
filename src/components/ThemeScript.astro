---
import { THEME_SCRIPT } from '@/lib/theme-script';

// The browser-chrome colour for each theme, one tag per colour scheme. These are the page
// backgrounds (--color-parchment) and must stay literal: browsers read them before any CSS loads.
// The script sets both tags to the chosen theme, so a saved choice beats the system setting.
---

<!-- prettier-ignore -->
<meta name="theme-color" content="#FBF6EA" media="(prefers-color-scheme: light)" data-light="#FBF6EA" data-dark="#12151D" />
<!-- prettier-ignore -->
<meta name="theme-color" content="#12151D" media="(prefers-color-scheme: dark)" data-light="#FBF6EA" data-dark="#12151D" />
<script is:inline set:html={THEME_SCRIPT} />
