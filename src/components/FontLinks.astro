---
// Linked from <head> rather than @import-ed from global.css, so the browser
// starts fetching the fonts with the page instead of after the stylesheet.
const TEXT_FONTS =
  'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap';
// Only the icons the site uses. display=block keeps icon names from flashing up as text.
const ICON_FONT =
  'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=award_star,directions_walk,explore,fact_check,history_edu,military_tech,my_location,newspaper,restaurant&display=block';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={TEXT_FONTS} />
<link rel="stylesheet" href={ICON_FONT} />
