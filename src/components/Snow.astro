---
// Gentle Christmas snowfall: a canvas of slow flakes that ignores clicks. Behind the `snow`
// Vercel Flags flag (src/lib/snow.ts, read via /api/flags/snow) and motion-safe. `?snow` previews
// it without the flag. The script is bundled, so it needs no CSP hash.
---

<canvas id="snow" class="snow" aria-hidden="true" hidden></canvas>

<style>
  /* A click-through layer over the page, under the skip link. */
  .snow {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 55;
    pointer-events: none;
  }
  .snow[hidden] {
    display: none;
  }
</style>

<script>
  interface Flake {
    x: number;
    y: number;
    radius: number;
    speed: number;
    drift: number;
    phase: number;
    opacity: number;
  }

  const FLAG_TIMEOUT_MS = 3000;
  const RESIZE_DEBOUNCE_MS = 150;

  const root = document.documentElement;
  const canvas = document.getElementById('snow') as HTMLCanvasElement | null;
  const context = canvas?.getContext('2d');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const enabled = async () => {
    if (new URLSearchParams(location.search).has('snow')) return true;
    try {
      const response = await fetch('/api/flags/snow', {
        signal: AbortSignal.timeout(FLAG_TIMEOUT_MS),
      });
      return response.ok && (await response.json()).enabled === true;
    } catch {
      return false;
    }
  };

  const run = (canvas: HTMLCanvasElement, context: CanvasRenderingContext2D) => {
    let width = 0;
    let height = 0;
    let flakes: Flake[] = [];
    let frame = 0;
    let last = 0;
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    let halo = '';

    const spawn = (anywhere: boolean): Flake => ({
      x: Math.random() * width,
      y: anywhere ? Math.random() * height : -10,
      radius: 1.5 + Math.random() * 2.5,
      speed: 18 + Math.random() * 28,
      drift: 8 + Math.random() * 14,
      phase: Math.random() * Math.PI * 2,
      opacity: 0.55 + Math.random() * 0.4,
    });

    // White flakes vanish on the cream page, so light mode gets a cool blue-grey halo.
    const syncTheme = () => {
      halo =
        root.dataset.theme === 'dark' ? 'rgba(255, 255, 255, 0.25)' : 'rgba(70, 100, 150, 0.55)';
    };

    // Keeps the flakes already falling: only the canvas is resized and the count topped up or trimmed.
    const resize = () => {
      const ratio = window.devicePixelRatio || 1;
      const previousWidth = width;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (previousWidth) for (const flake of flakes) flake.x *= width / previousWidth;
      // Fewer flakes on small screens keeps it gentle.
      const count = Math.round(Math.min(110, Math.max(35, (width * height) / 14000)));
      if (flakes.length > count) flakes.length = count;
      while (flakes.length < count) flakes.push(spawn(true));
    };

    const draw = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      context.clearRect(0, 0, width, height);
      context.strokeStyle = halo;
      context.fillStyle = 'rgb(255, 255, 255)';
      context.lineWidth = 1;
      for (const flake of flakes) {
        flake.y += flake.speed * dt;
        flake.phase += dt * 0.8;
        flake.x += Math.sin(flake.phase) * flake.drift * dt;
        if (flake.y > height + 10) Object.assign(flake, spawn(false));
        if (flake.x < -10) flake.x = width + 10;
        else if (flake.x > width + 10) flake.x = -10;
        context.globalAlpha = flake.opacity;
        context.beginPath();
        context.arc(flake.x, flake.y, flake.radius, 0, Math.PI * 2);
        context.fill();
        context.stroke();
      }
      frame = requestAnimationFrame(draw);
    };

    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    const start = () => {
      if (frame || reducedMotion.matches || document.hidden) return;
      last = performance.now();
      frame = requestAnimationFrame(draw);
    };

    const sync = () => {
      stop();
      canvas.hidden = reducedMotion.matches;
      start();
    };

    syncTheme();
    resize();
    sync();
    new MutationObserver(syncTheme).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, RESIZE_DEBOUNCE_MS);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reducedMotion.addEventListener('change', sync);
  };

  // Not awaited at the top level, so a slow flag check never holds up the rest of the page's scripts.
  void enabled().then((on) => {
    if (on && canvas && context) run(canvas, context);
  });
</script>
