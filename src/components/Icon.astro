---
import { ICON_PATHS, ICON_VIEWBOX, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox={ICON_VIEWBOX} fill="currentColor" aria-hidden="true" focusable="false">
  <path d={ICON_PATHS[name]}></path>
</svg>
