---
// Installed apps have no browser back button (iOS especially). This one only shows when the page
// runs standalone, and not on the home page, which has nowhere to go back to.
interface Props {
  /** The home page has nowhere to go back to. */
  hidden?: boolean;
}
const { hidden = false } = Astro.props;
---

{!hidden && (
  <div class="standalone-bar">
    <button type="button" class="standalone-back" data-standalone-back aria-label="Go back">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 5l-7 7 7 7" />
      </svg>
      <span>Back</span>
    </button>
  </div>
)}

<style>
  .standalone-bar {
    display: none;
    width: min(100% - 28px, 1440px);
    margin-inline: auto;
  }

  .standalone-back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 0.5rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    background: none;
    cursor: pointer;
  }

  @media (display-mode: standalone) {
    .standalone-bar {
      display: block;
    }
  }
</style>
