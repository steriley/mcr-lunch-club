---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button type="button" class:list={['theme-toggle', className]} data-theme-toggle aria-label="Switch to dark mode">
  <svg class="theme-toggle-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  </svg>
  <svg class="theme-toggle-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
</button>

<script>
  import { THEME_CHANGE_EVENT, THEME_STORAGE_KEY, currentTheme, type Theme } from '@/lib/theme';

  const label = (theme: Theme) => (theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => buttons.forEach((button) => button.setAttribute('aria-label', label(currentTheme())));

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // Private windows can refuse storage; the choice then lasts for this page.
      }
      (window as unknown as { __mcrApplyTheme?: (theme: Theme) => void }).__mcrApplyTheme?.(next);
      window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT));
    });
  });

  window.addEventListener(THEME_CHANGE_EVENT, sync);
  sync();
</script>
