---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- A switch in the footer: "Dark mode", pressed while the dark theme is on. -->
<button type="button" class:list={['theme-toggle', className]} data-theme-toggle aria-pressed="false">
  <svg class="theme-toggle-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  </svg>
  <span>Dark mode</span>
  <span class="theme-toggle-track" aria-hidden="true"><span class="theme-toggle-knob"></span></span>
</button>

<script>
  import { THEME_CHANGE_EVENT, THEME_STORAGE_KEY, currentTheme, type Theme } from '@/lib/theme';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => buttons.forEach((button) => button.setAttribute('aria-pressed', String(currentTheme() === 'dark')));

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // Private windows can refuse storage; the choice then lasts for this page.
      }
      (window as unknown as { __mcrApplyTheme?: (theme: Theme) => void }).__mcrApplyTheme?.(next);
      window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT));
    });
  });

  window.addEventListener(THEME_CHANGE_EVENT, sync);
  sync();
</script>
