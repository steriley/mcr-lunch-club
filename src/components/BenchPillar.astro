---
import BenchWalk from '@/components/BenchWalk.astro';
import { focalStyle } from '@/lib/image-upload';
import { formatDate } from '@/lib/dates';
import { INSPECTION_KIND_LABELS, INSPECTION_OUTCOME_BADGE_CLASSES, INSPECTION_OUTCOME_LABELS } from '@/lib/inspection-display';
import type { BenchCard } from '@/lib/sovereign-bench';
import type { Inspection } from '@/types';

interface Props {
  pillar: BenchCard;
  /** Render one inspection of the venue (the /inspections ledger) instead of the venue summary. */
  inspection?: Inspection;
}

const { pillar, inspection } = Astro.props;
---

<article class="bench-pillar">
  <div class="bench-pillar-main">
    <div class="bench-thumb">
      <span class="bench-placeholder" aria-hidden="true">
        <img src="/brand/approved-sticker-256.webp" alt="" />
      </span>
      {pillar.image && (
        <img
          class="bench-image"
          src={pillar.image.thumbUrl}
          alt=""
          width="80"
          height="80"
          style={{ objectPosition: focalStyle(pillar.image) }}
          loading="lazy"
          decoding="async"
          onerror="this.onerror=null;this.parentElement.classList.add('is-placeholder')"
        />
      )}
    </div>
    <div class="bench-pillar-copy">
      <div class="bench-pillar-title-row">
        <h3 class="bench-pillar-name">
          <a class="bench-pillar-link" href={pillar.href}>
            {pillar.name}
          </a>
        </h3>
        <span class="bench-cost">{pillar.cost}</span>
      </div>
      {inspection ? (
        <p class="bench-last bench-inspection-date">Inspected: {formatDate(inspection.date)}</p>
      ) : (
        pillar.lastInspection && <p class="bench-last">Last Inspection: {pillar.lastInspection}</p>
      )}
      {inspection ? (
        <div class="bench-inspection-badges">
          <span class={`bench-count ${inspection.kind === 'legacy' ? 'is-legacy' : ''}`}>{INSPECTION_KIND_LABELS[inspection.kind]}</span>
          {inspection.outcome && (
            <span class={`bench-badge ${INSPECTION_OUTCOME_BADGE_CLASSES[inspection.outcome]}`}>
              {INSPECTION_OUTCOME_LABELS[inspection.outcome]}
            </span>
          )}
        </div>
      ) : pillar.quote ? (
        <p class="bench-pillar-text is-quote">{pillar.quote}</p>
      ) : (
        pillar.eatLikeUs && <p class="bench-pillar-text">Eat like us: {pillar.eatLikeUs}</p>
      )}
    </div>
  </div>
  <div class="bench-telemetry">
    <BenchWalk walk={pillar.walk} venueName={pillar.name} />
    {pillar.inspectionCount > 0 && (
      <span class="bench-count">{pillar.inspectionCount} {pillar.inspectionCount === 1 ? 'Inspection' : 'Inspections'}</span>
    )}
  </div>
</article>
