---
type QuoteLine = string | { text: string; /** Set in the brand orange. */ accent?: boolean };

interface Props {
  icon: string;
  /** Small uppercase label above the title. */
  kicker: string;
  title: string;
  /** The italic copy under the title; give several lines to stack them. */
  quote?: QuoteLine | QuoteLine[];
  /** Supporting text under a divider, in the body face. */
  description?: string;
  /** Background utility class; the ink colour by default, or a tier's own colour. */
  bannerClass?: string;
  /** Match the content column below, so the ribbon text lines up with it. */
  width?: string;
}

const { icon, kicker, title, quote, description, bannerClass = 'bg-deep', width = 'max-w-6xl' } = Astro.props;
const quoteLines = (quote === undefined ? [] : Array.isArray(quote) ? quote : [quote]).map((line) =>
  typeof line === 'string' ? { text: line, accent: false } : { text: line.text, accent: line.accent ?? false }
);
const onTier = bannerClass !== 'bg-deep';
---

<!-- One ribbon for the Manifesto, Tiers and Inspections pages, so their type and spacing match. -->
<div class={`${bannerClass} tier-header-gradient text-parchment-fixed w-full font-serif-header`}>
  <div class={`${width} mx-auto px-4 w-full`}>
    <div class="p-6 sm:p-8 space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-3xl sm:text-4xl">{icon}</span>
        <div>
          <span class={`text-xs uppercase tracking-widest font-bold ${onTier ? 'text-parchment-fixed' : 'text-gold'}`}>
            {kicker}
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">{title}</h1>
        </div>
      </div>

      {quoteLines.length > 0 && (
        <div class="space-y-2 pt-1 max-w-3xl text-base sm:text-lg italic leading-snug">
          {quoteLines.map((line) => <p class:list={[line.accent && 'text-gold']}>“{line.text}”</p>)}
        </div>
      )}

      {description && (
        <p class="text-xs sm:text-sm text-stone-200 font-sans max-w-3xl leading-relaxed pt-2 border-t border-white/20">
          {description}
        </p>
      )}

      <slot />
    </div>
  </div>
</div>
