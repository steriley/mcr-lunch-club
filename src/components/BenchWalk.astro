---
import type { BenchWalk } from '@/lib/sovereign-bench';

interface Props {
  walk: BenchWalk;
  venueName: string;
}

const { walk, venueName } = Astro.props;
---

{
  walk.directionsUrl ? (
    <a
      class="bench-walk is-link"
      href={walk.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Walking directions to ${venueName}`}
      data-walk-directions
      data-lat={walk.lat}
      data-lng={walk.lng}
    >
      <span class="material-symbols-outlined" aria-hidden="true">directions_walk</span>
      {walk.label}
    </a>
  ) : (
    <span class="bench-walk">
      <span class="material-symbols-outlined" aria-hidden="true">directions_walk</span>
      {walk.label}
    </span>
  )
}
