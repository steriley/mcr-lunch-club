---
import Layout from '@/layouts/Layout.astro';
import BenchPillar from '@/components/BenchPillar.astro';
import { getPublicInspections, getPublicVenues, setPublicCacheHeaders } from '@/lib/public-data';
import { toCard } from '@/lib/sovereign-bench';

export const prerender = false;

const [inspections, venues] = await Promise.all([getPublicInspections(), getPublicVenues()]);
const venuesBySlug = new Map(venues.map((venue) => [venue.slug, venue]));
setPublicCacheHeaders(Astro.response.headers);
const verifiedCount = inspections.filter((inspection) => inspection.kind === 'verified').length;
const legacyCount = inspections.length - verifiedCount;
---

<Layout title="The Inspection Audits — Chronological Ledger | MCR Lunch Club">
  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12 w-full space-y-8 font-serif-header">
    <!-- Breadcrumb -->
    <div class="text-xs">
      <a href="/" class="text-[#8b1e22] hover:underline flex items-center gap-1 font-bold">
        <span>←</span>
        <span>Return to Sovereign Map</span>
      </a>
    </div>

    <!-- Header Card -->
    <div class="bg-[#1a1e24] text-[#f9f7f1] p-6 sm:p-10 rounded-2xl border-2 border-[#c59b27] shadow-2xl relative overflow-hidden">
      <div class="relative z-10 space-y-3">
        <div class="flex items-center gap-3">
          <span class="text-4xl">📋</span>
          <div>
            <span class="text-xs uppercase tracking-widest text-[#c59b27] font-bold font-mono">
              Operational Field Ledger
            </span>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f9f7f1]">
              The Inspection Audits
            </h1>
          </div>
        </div>

        <p class="text-sm sm:text-base text-stone-300 italic pt-1 border-t border-[#c59b27]/30 max-w-3xl">
          “Every verdict herein is etched in indelible ink. The Two-Visit Rule dictates that excellence must be demonstrated twice under fire; mediocrity is rewarded with swift eviction.”
        </p>

        <div class="pt-2 flex items-center gap-4 text-xs font-sans">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span>Dual-verified Inspections: <strong>{verifiedCount}</strong></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-stone-400"></span>
            <span>Legacy Records: <strong>{legacyCount}</strong></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Inspection List -->
    <div class="space-y-4 font-sans">
      <div class="flex items-center justify-between border-b border-[#dcd6c8] pb-2 font-serif-header">
        <h2 class="text-xl font-bold text-[#1a1e24] flex items-center gap-2">
          <span>Audit Registry</span>
          <span class="text-xs font-mono font-bold bg-[#8b1e22] text-white px-2 py-0.5 rounded">
            {inspections.length} Entries
          </span>
        </h2>
        <span class="text-xs text-stone-500 font-sans">
          Sorted by Date Recorded
        </span>
      </div>

      {inspections.length === 0 ? (
        <div class="p-6 text-center bg-stone-50 rounded-xl border border-dashed border-stone-300 text-base text-stone-500">
          No inspections are on record yet. An inspection is entered here once two Chairs confirm the same day's visit.
        </div>
      ) : (
        <div class="bench-pillars tier-venue-grid">
          {inspections.map((insp) => {
            const venue = venuesBySlug.get(insp.venueSlug);
            return venue && <BenchPillar pillar={toCard({ venue }, [insp])} inspection={insp} />;
          })}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  import { getWalkingDirectionsUrl } from '@/lib/map/directions';

  // Apple devices get Apple Maps, like the homepage walk links.
  document.querySelectorAll<HTMLAnchorElement>('a[data-walk-directions]').forEach((link) => {
    const lat = Number(link.dataset.lat);
    const lng = Number(link.dataset.lng);
    if (Number.isFinite(lat) && Number.isFinite(lng)) link.href = getWalkingDirectionsUrl(lat, lng);
  });
</script>
