---
import Layout from '@/layouts/Layout.astro';
import BenchPillar from '@/components/BenchPillar.astro';
import PageRibbon from '@/components/PageRibbon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getPublicInspections, getPublicVenues } from '@/lib/public-data';
import { toCard } from '@/lib/sovereign-bench';

// Built with the site; admin saves trigger a rebuild (src/lib/rebuild.ts).
export const prerender = true;

const [inspections, venues] = await Promise.all([getPublicInspections(), getPublicVenues()]);
const venuesBySlug = new Map(venues.map((venue) => [venue.slug, venue]));
---

<Layout title="The Inspection Audits — Chronological Ledger | MCR Lunch Club" description="Every confirmed MCR Lunch Club inspection of a Manchester lunch venue, newest first.">
  <PageRibbon
    icon="clipboard"
    kicker="Operational Field Ledger"
    title="The Inspection Audits"
    quote="Every verdict herein is etched in indelible ink. The Two-Visit Rule dictates that excellence must be demonstrated twice under fire; mediocrity is rewarded with swift eviction."
    width="max-w-5xl"
  />

  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12 w-full space-y-8">
    <Breadcrumbs items={[{ label: 'Map', href: '/' }, { label: 'Inspections' }]} />

    <!-- Inspection List -->
    <div class="space-y-4 font-sans">
      <div class="space-y-2">
        <div class="border-b border-hairline pb-2 flex items-end justify-between gap-4">
          <div class="space-y-1">
            <h2 class="text-xl font-bold text-ink">Audit Registry</h2>
            <p class="text-xs font-sans tabular-nums text-stone-500">Most recent first</p>
          </div>
          <span class="bench-count shrink-0">{inspections.length} Inspections</span>
        </div>
      </div>

      {inspections.length === 0 ? (
        <div class="p-6 text-center bg-stone-50 rounded-xl border border-dashed border-stone-300 text-base text-stone-500">
          No inspections are on record yet. An inspection is entered here once two Chairs confirm the same day's visit.
        </div>
      ) : (
        <div class="bench-pillars inspection-rows">
          {inspections.map((insp) => {
            const venue = venuesBySlug.get(insp.venueSlug);
            return venue && <BenchPillar pillar={toCard({ venue }, inspections)} inspection={insp} />;
          })}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  import { getWalkingDirectionsUrl } from '@/lib/map/directions';

  // Apple devices get Apple Maps, like the homepage walk links.
  document.querySelectorAll<HTMLAnchorElement>('a[data-walk-directions]').forEach((link) => {
    const lat = Number(link.dataset.lat);
    const lng = Number(link.dataset.lng);
    if (Number.isFinite(lat) && Number.isFinite(lng)) link.href = getWalkingDirectionsUrl(lat, lng);
  });
</script>
