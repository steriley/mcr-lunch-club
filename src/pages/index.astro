---
import Layout from '@/layouts/Layout.astro';
import FilterBar from '@/components/islands/FilterBar.vue';
import LunchMap from '@/components/islands/LunchMap.vue';
import NearMeLoader from '@/components/islands/NearMeLoader.vue';
import VenueSheet from '@/components/islands/VenueSheet.vue';
import WhereToday from '@/components/islands/WhereToday.vue';
import WeatherCard from '@/components/WeatherCard.vue';
import ChairsDeliberation from '@/components/ChairsDeliberation.vue';
import SuggestModal from '@/components/islands/SuggestModal.vue';
import BenchPillar from '@/components/BenchPillar.astro';
import BenchWalk from '@/components/BenchWalk.astro';
import LedgerCanon from '@/components/LedgerCanon.astro';
import { formatDate } from '@/lib/dates';
import { focalStyle } from '@/lib/image-upload';
import { getPublicMapApiKey } from '@/lib/env';
import { getGoldenCut, getMapVenues, getPublicInspections } from '@/lib/public-data';
import { getRecentTierChanges } from '@/lib/recent-tier-changes';
import { walkText } from '@/lib/route-display';
import { buildSovereignBench } from '@/lib/sovereign-bench';
import { bulletinIssue, bulletinText, changesInIssue, gazetteLabel } from '@/lib/weekly-bulletin';
import { seedLedgerInspections, seedLedgerVenues } from '@/stores/ledger';

// Built with the site; admin saves trigger a rebuild (src/lib/rebuild.ts), and so does the
// Wednesday evening bulletin (src/pages/api/cron/weekly-bulletin.ts).
export const prerender = true;

const issue = bulletinIssue();
// Closed venues never go on the map or in Near Me.
const [venuesData, inspectionsData, goldenCut, recentTierChanges] = await Promise.all([
  getMapVenues(),
  getPublicInspections(),
  getGoldenCut(),
  getRecentTierChanges(issue),
]);
seedLedgerVenues(venuesData);
seedLedgerInspections(inspectionsData);

const publicMapApiKey = getPublicMapApiKey();
const bulletin = bulletinText(changesInIssue(recentTierChanges, issue));
// Already in public order: nearest first.
const approvedVenues = venuesData.filter((venue) => venue.tier === 'approved');
const { mode, hero, pillars } = buildSovereignBench(goldenCut, venuesData, inspectionsData);
const isGoldenCut = mode === 'golden-cut';
// Lists are already nearest first, unknown walking times last.
const valueShortcut = approvedVenues.find((venue) => venue.cost === '£');
// Inspections are newest first, so the first one at another Approved venue is the freshest verdict.
const freshInspection = inspectionsData.find((inspection) =>
  approvedVenues.some((venue) => venue.slug === inspection.venueSlug && venue !== valueShortcut)
);
const freshShortcut = approvedVenues.find((venue) => venue.slug === freshInspection?.venueSlug);
const scrutinyShortcut = venuesData.find((venue) => venue.tier === 'under_consideration');
const latestLedgerEntry = inspectionsData[0];
const scrutinyAuditCount = scrutinyShortcut
  ? inspectionsData.filter((inspection) => inspection.venueSlug === scrutinyShortcut.slug).length
  : 0;
const fieldShortcuts = [
  {
    label: 'High value',
    venue: valueShortcut,
    detail: valueShortcut ? `${valueShortcut.cost} · ${walkText(valueShortcut.walkingTimeMin)}` : '',
    variant: 'is-approved',
  },
  {
    label: 'Freshly inspected',
    venue: freshShortcut,
    detail: freshShortcut && freshInspection ? `Inspected ${formatDate(freshInspection.date)} · ${walkText(freshShortcut.walkingTimeMin)}` : '',
    variant: 'is-approved',
  },
  {
    label: 'Under scrutiny',
    venue: scrutinyShortcut,
    detail: `${scrutinyAuditCount} ${scrutinyAuditCount === 1 ? 'inspection' : 'inspections'} on record · ${walkText(scrutinyShortcut?.walkingTimeMin ?? null)}`,
    variant: 'is-consideration',
  },
].filter((shortcut) => shortcut.venue);
---

<Layout title="MCR Lunch Club — The Official Manchester Lunch Ledger">
  <LedgerCanon venues={venuesData} inspections={inspectionsData} />
  <FilterBar client:load />

  <div class="home-workspace">
    <div class="home-workspace-grid">
      <div class="home-map-column">
        <section class="home-map-stage relative w-full flex flex-col">
          <LunchMap client:load mapApiKey={publicMapApiKey} />
          <NearMeLoader client:only="vue" mapApiKey={publicMapApiKey} />
          <VenueSheet client:load />
          <WhereToday client:idle />
          <SuggestModal client:idle />
        </section>

        <section class="field-dispatch" aria-label="Tribunal field dispatch">
          <div class="weekly-bulletin">
            <span class="bulletin-icon" aria-hidden="true">
              <span class="material-symbols-outlined">newspaper</span>
            </span>
            <div class="bulletin-copy">
              <strong>Weekly inspection bulletin</strong>
              <p>{bulletin}</p>
            </div>
            <a href="/inspections">{gazetteLabel(issue)}</a>
          </div>

          <div class="field-panel-grid">
            <ChairsDeliberation client:idle />

            <WeatherCard client:visible />
          </div>

          <section class="field-shortcuts" aria-labelledby="field-shortcuts-title">
            <div class="field-shortcuts-heading">
              <h2 id="field-shortcuts-title">
                <svg class="field-icon is-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 3h10l4 4v4M5 3v18h7m3-18v5h5m-9 9 2.5 2.5L19 13m-8 5h-2v-2l6.6-6.6a1.4 1.4 0 0 1 2 2L11 18Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Auditor's Fast Docket &amp; Field Shortcuts
              </h2>
              {latestLedgerEntry && <span>Latest audit · {formatDate(latestLedgerEntry.date)}</span>}
            </div>
            <div class="field-shortcut-grid">
              {fieldShortcuts.map(({ label, venue, detail, variant }) => venue && (
                <a class:list={['field-shortcut', variant]} href={`/venues/${venue.slug}`}>
                  <span class="field-shortcut-label">{label}</span>
                  <strong>{venue.name}</strong>
                  <span class="field-shortcut-detail">{detail}</span>
                </a>
              ))}
            </div>
          </section>
        </section>
      </div>

      <aside class="bench" aria-labelledby="bench-title">
        <div class="bench-header">
          <div class="bench-header-copy">
            <p class="bench-kicker">
              <span class="material-symbols-outlined" aria-hidden="true">award_star</span>
              {isGoldenCut ? "The Golden Cut // The Chairs’ Permanent Quintet" : 'Gazetted roll call // Nearest approved'}
            </p>
            <h1 class="bench-title" id="bench-title">The Sovereign Bench of Manchester Lunch</h1>
          </div>
          <span class="bench-header-pill">{isGoldenCut ? 'Top lunching guaranteed' : 'Ranked by proximity'}</span>
        </div>

        {hero ? (
          <article class="bench-hero">
            <div class="bench-hero-media">
              <span class="bench-placeholder" aria-hidden="true"></span>
              {hero.image && (
                <img
                  class="bench-image"
                  src={hero.image.url}
                  alt={hero.image.alt}
                  width={hero.image.width ?? undefined}
                  height={hero.image.height ?? undefined}
                  style={{ objectPosition: focalStyle(hero.image) }}
                  decoding="async"
                  onerror="this.onerror=null;this.parentElement.classList.add('is-placeholder')"
                />
              )}
              <a class="bench-seal" href={hero.href} aria-label={`View ${hero.name}'s audit`}>
                <img src="/brand/approved-sticker-256.webp" width="256" height="256" alt="" />
              </a>
            </div>

            <div class="bench-hero-body">
              <div class="bench-hero-heading">
                <div class="bench-hero-title-row">
                  <h2 class="bench-hero-name"><a class="bench-hero-link" href={hero.href}>{hero.name}</a></h2>
                  <span class="bench-cost">{hero.cost}</span>
                </div>
                {hero.lastInspection && <p class="bench-last">Last Inspection: {hero.lastInspection}</p>}
              </div>

              {hero.eatLikeUs && (
                <div class="bench-eat">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7 3v7m-2.5-7v5a2.5 2.5 0 0 0 5 0V3M7 10v11M17 21V3c-2.2 1.2-3.5 3.7-3.5 7.2V14H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div>
                    <span class="bench-eat-label">Eat like us</span>
                    <span class="bench-eat-dish">{hero.eatLikeUs}</span>
                  </div>
                </div>
              )}

              {hero.quote && (
                <blockquote class="bench-quote">
                  <p>“{hero.quote}”</p>
                  <cite>— The Chairs</cite>
                </blockquote>
              )}

              <div class="bench-telemetry">
                <BenchWalk walk={hero.walk} venueName={hero.name} />
                {hero.inspectionCount > 0 && (
                  <span class="bench-count">{hero.inspectionCount} {hero.inspectionCount === 1 ? 'Inspection' : 'Inspections'}</span>
                )}
              </div>
            </div>
          </article>
        ) : (
          <p class="bench-empty">No approved venues are on the bench yet.</p>
        )}

        {pillars.length > 0 && (
          <div class="bench-pillars-section">
            <p class="bench-pillars-label">{isGoldenCut ? 'Chair-inspected & approved' : 'Approved & on the record'}</p>
            <div class="bench-pillars">
              {pillars.map((pillar) => <BenchPillar pillar={pillar} />)}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>
