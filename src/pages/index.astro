---
import Layout from '@/layouts/Layout.astro';
import FilterBar from '@/components/islands/FilterBar.vue';
import LunchMap from '@/components/islands/LunchMap.vue';
import NearMeMap from '@/components/islands/NearMeMap.vue';
import VenueSheet from '@/components/islands/VenueSheet.vue';
import WhereToday from '@/components/islands/WhereToday.vue';
import WeatherCard from '@/components/WeatherCard.vue';
import SuggestModal from '@/components/islands/SuggestModal.vue';
import LedgerCanon from '@/components/LedgerCanon.astro';
import { formatDate } from '@/lib/dates';
import { getPublicMapApiKey } from '@/lib/env';
import { getMapVenues, getPublicInspections, setPublicCacheHeaders } from '@/lib/public-data';
import { milesText, walkText } from '@/lib/route-display';
import { seedLedgerInspections, seedLedgerVenues } from '@/stores/ledger';

export const prerender = false;

// Closed venues never go on the map or in Near Me.
const [venuesData, inspectionsData] = await Promise.all([getMapVenues(), getPublicInspections()]);
seedLedgerVenues(venuesData);
seedLedgerInspections(inspectionsData);
setPublicCacheHeaders(Astro.response.headers);

const publicMapApiKey = getPublicMapApiKey();
// Already in public order: nearest first.
const approvedVenues = venuesData.filter((venue) => venue.status === 'Approved');
// Position by proximity, shown as the docket number.
const proximityRank = (slug: string) => approvedVenues.findIndex((venue) => venue.slug === slug) + 1;
const featuredVenue = approvedVenues.find((venue) => venue.slug === 'crazy-pedros');
const docketVenues = approvedVenues
  .filter((venue) => venue.slug !== featuredVenue?.slug)
  .slice(0, 4);
const featuredInspections = featuredVenue
  ? inspectionsData.filter((inspection) => inspection.venueSlug === featuredVenue.slug)
  : [];
// Newest first.
const verifiedAudits = featuredInspections.filter((inspection) => inspection.kind === 'verified');
const latestAudit = featuredInspections[0];
const featuredAddress = featuredVenue?.address.split(',')[0] ?? '';
// Lists are already nearest first, unknown walking times last.
const valueShortcut = approvedVenues.find((venue) => venue.cost === '£');
const swiftShortcut = approvedVenues.find((venue) => venue !== valueShortcut);
const scrutinyShortcut = venuesData.find((venue) => venue.status === 'Under Consideration');
const latestLedgerEntry = inspectionsData[0];
const scrutinyAuditCount = scrutinyShortcut
  ? inspectionsData.filter((inspection) => inspection.venueSlug === scrutinyShortcut.slug).length
  : 0;
const fieldShortcuts = [
  {
    label: 'High value',
    venue: valueShortcut,
    detail: valueShortcut ? `${valueShortcut.cost} · ${valueShortcut.cuisine} · ${walkText(valueShortcut.walkingTimeMin)}` : '',
    variant: 'is-approved',
  },
  {
    label: 'Swift exit',
    venue: swiftShortcut,
    detail: swiftShortcut ? `${swiftShortcut.cuisine} · ${walkText(swiftShortcut.walkingTimeMin)}` : '',
    variant: 'is-approved',
  },
  {
    label: 'Under scrutiny',
    venue: scrutinyShortcut,
    detail: `${scrutinyAuditCount} ${scrutinyAuditCount === 1 ? 'inspection' : 'inspections'} on record · ${walkText(scrutinyShortcut?.walkingTimeMin ?? null)}`,
    variant: 'is-consideration',
  },
].filter((shortcut) => shortcut.venue);
---

<Layout title="MCR Lunch Club — The Official Manchester Lunch Ledger">
  <LedgerCanon venues={venuesData} inspections={inspectionsData} />
  <FilterBar client:load />

  <div class="home-workspace">
    <div class="home-workspace-grid">
      <div class="home-map-column">
        <section class="home-map-stage relative w-full flex flex-col">
          <LunchMap client:load mapApiKey={publicMapApiKey} />
          <NearMeMap client:only="vue" mapApiKey={publicMapApiKey} />
          <VenueSheet client:load />
          <WhereToday client:idle />
          <SuggestModal client:idle />
        </section>

        <section class="field-dispatch" aria-label="Tribunal field dispatch">
          <div class="weekly-bulletin">
            <span class="bulletin-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="m14.2 5.1 4.7 4.7m-7.1-2.4 4.8-4.8m-9.8 7.4 7.1-7.1m-8.6 9.6 7.1 7.1m-2.8-4.7 4.8-4.8M4 20h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div class="bulletin-copy">
              <strong>Weekly inspection bulletin</strong>
              <p>2 venues re-inspected on Bridge St this Wednesday. 1 elevation to Approved, 1 referral.</p>
            </div>
            <a href="/inspections">Gazette #41</a>
          </div>

          <div class="field-panel-grid">
            <article class="field-panel">
              <div class="field-panel-heading">
                <h2>
                  <svg class="field-icon is-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3v17M5 6h14M7 6 3.8 13h6.4L7 6Zm10 0-3.2 7h6.4L17 6ZM7 20h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  Chairs' Deliberation
                </h2>
                <span class="decree-badge">Decree #284</span>
              </div>
              <blockquote class="deliberation-quote">
                “Never queue past 12:35 without contingency pastry. If a venue has no lunchtime trade by 12:45, suspect refrigeration failure.”
              </blockquote>
              <div class="field-panel-footer">
                <span>Chair Henderson presiding</span>
                <a href="/manifesto">Read Codex <span aria-hidden="true">→</span></a>
              </div>
            </article>

            <WeatherCard client:visible />
          </div>

          <section class="field-shortcuts" aria-labelledby="field-shortcuts-title">
            <div class="field-shortcuts-heading">
              <h2 id="field-shortcuts-title">
                <svg class="field-icon is-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 3h10l4 4v4M5 3v18h7m3-18v5h5m-9 9 2.5 2.5L19 13m-8 5h-2v-2l6.6-6.6a1.4 1.4 0 0 1 2 2L11 18Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Auditor's Fast Docket &amp; Field Shortcuts
              </h2>
              {latestLedgerEntry && <span>Latest audit · {formatDate(latestLedgerEntry.date)}</span>}
            </div>
            <div class="field-shortcut-grid">
              {fieldShortcuts.map(({ label, venue, detail, variant }) => venue && (
                <a class:list={['field-shortcut', variant]} href={`/venues/${venue.slug}`}>
                  <span class="field-shortcut-label">{label}</span>
                  <strong>{venue.name}</strong>
                  <span class="field-shortcut-detail">{detail}</span>
                </a>
              ))}
            </div>
          </section>
        </section>
      </div>

      <aside aria-labelledby="docket-title">
        <div class="docket-heading">
          <div>
            <span class="docket-kicker">Gazetted roll call</span>
            <h1 class="docket-title" id="docket-title">Active Verdicts on the Docket</h1>
          </div>
          <span class="docket-sort">Ranked<br />by proximity</span>
        </div>

        {featuredVenue && (
          <article class="docket-panel docket-feature">
            <div class="docket-feature-ribbon">
              <div class="docket-register">
                <span>Ledger ref: #{String(proximityRank(featuredVenue.slug)).padStart(2, '0')}-{featuredAddress.split(' ')[1]?.toUpperCase()}</span>
                <span class="docket-ribbon-divider">/</span>
                <span>Inspection confirmed</span>
              </div>
              <strong class="docket-double-visited">Double visited</strong>
            </div>

            <div class="docket-photo">
              <img
                src={featuredVenue.imageUrl ?? '/venues/crazy-pedros-promo.jpg'}
                alt="Crazy Pedro’s pizzas outside the Manchester venue"
                class="docket-photo-image"
              />
              <img
                src="/brand/approved-sticker.png"
                alt="MCR Lunch Club Approved"
                class="docket-photo-seal"
              />
              <div class="docket-verdict-stamp">
                <span class="docket-verdict-stamp-icon" aria-hidden="true">✓</span>
                <span>
                  <strong>Approved</strong>
                  <small>{verifiedAudits.length} verified {verifiedAudits.length === 1 ? 'inspection' : 'inspections'}</small>
                </span>
              </div>
            </div>

            <div class="docket-feature-body">
              <div class="docket-feature-title-row">
                <div>
                  <a class="docket-venue-name" href={`/venues/${featuredVenue.slug}`}>{featuredVenue.name}</a>
                  <div class="docket-venue-meta">{featuredVenue.cuisine} · {featuredAddress}</div>
                </div>
                <span class="docket-cost">{featuredVenue.cost}</span>
              </div>

              <div class="docket-stat-grid">
                <div>
                  <span>From base</span>
                  <strong>{walkText(featuredVenue.walkingTimeMin)}</strong>
                </div>
                <div>
                  <span>Distance</span>
                  <strong>{milesText(featuredVenue.distanceMiles)}</strong>
                </div>
                <div>
                  <span>Audits filed</span>
                  <strong>{verifiedAudits.length} verified</strong>
                </div>
              </div>

              <div class="docket-feature-tags">
                <span class="docket-feature-tag is-approved">Eat Like Us: 2 Slice Lunch Deal</span>
                {latestAudit && <span class="docket-feature-tag">Last audit: {formatDate(latestAudit.date)}</span>}
                <span class="docket-feature-tag">Tier: Approved</span>
              </div>

              <div class="docket-feature-actions">
                <a class="docket-action" href={`/venues/${featuredVenue.slug}`}>
                  <span aria-hidden="true">▤</span>
                  View Full Audit
                </a>
                <a class="docket-action is-secondary" href={featuredVenue.mapSearchLink} target="_blank" rel="noopener noreferrer">
                  <span aria-hidden="true">♙</span>
                  Route{featuredVenue.walkingTimeMin !== null && ` (${featuredVenue.walkingTimeMin}m)`}
                </a>
              </div>
            </div>
          </article>
        )}

        <div class="docket-list" aria-label="More approved venues">
          {docketVenues.map((venue) => (
            <a class="docket-list-item" href={`/venues/${venue.slug}`}>
              <span class="docket-list-image-wrap">
                <img
                  class="docket-list-image"
                  src={venue.imageUrl ?? `/venues/${venue.slug}.jpg`}
                  alt=""
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                  onerror="this.onerror=null;this.src='/brand/logo.png';this.classList.add('is-placeholder')"
                />
                <span class="docket-rank">#{String(proximityRank(venue.slug)).padStart(2, '0')}</span>
              </span>
              <span class="docket-list-content">
                <span class="docket-list-header">
                  <span class="docket-list-heading">
                    <span class="docket-list-name">{venue.name}</span>
                    <span class="docket-list-meta">{venue.cuisine}</span>
                  </span>
                  <span class="docket-list-cost">{venue.cost}</span>
                </span>
                <span class="docket-list-description">{venue.eatLikeUs}</span>
                <span class="docket-list-footer">
                  <span class="docket-list-walk">{walkText(venue.walkingTimeMin)} · {milesText(venue.distanceMiles, 'mi')}</span>
                  <span class="docket-list-tier">Approved tier</span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Layout>
