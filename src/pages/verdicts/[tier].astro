---
import Layout from '@/layouts/Layout.astro';
import TierChip from '@/components/TierChip.vue';
import BenchPillar from '@/components/BenchPillar.astro';
import PageRibbon from '@/components/PageRibbon.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getPublicInspections, getPublicVenues, type PublicVenue } from '@/lib/public-data';
import { toCard } from '@/lib/sovereign-bench';
import { sortByRecentInspection } from '@/lib/venue-order';
import { breadcrumbStructuredData } from '@/lib/structured-data';
import { serializeForScript } from '@/lib/public-data';
import { TIERS, countVenuesByTier, type Tier } from '@/lib/tiers';
import type { Inspection } from '@/types';

// Built with the site; admin saves trigger a rebuild (src/lib/rebuild.ts).
// An unknown tier slug has no page, so it gets src/pages/404.astro.
export const prerender = true;

export async function getStaticPaths() {
  const [publicVenues, inspections] = await Promise.all([getPublicVenues(), getPublicInspections()]);
  return TIERS.map((tier) => ({ params: { tier: tier.slug }, props: { tier, publicVenues, inspections } }));
}

interface Props {
  tier: Tier;
  publicVenues: PublicVenue[];
  inspections: Inspection[];
}

const { tier, publicVenues, inspections } = Astro.props;
// Most recently inspected first, then A to Z.
const venues = sortByRecentInspection(publicVenues.filter((venue) => venue.tier === tier.value), inspections);
const cards = venues.map((venue) => toCard({ venue }, inspections));
const tierCounts = countVenuesByTier(publicVenues);
const breadcrumbs = [{ label: 'Map', href: '/' }, { label: 'Verdicts', href: '/verdicts/approved' }, { label: tier.label }];
const breadcrumbData = breadcrumbStructuredData(
  breadcrumbs.map(({ label, href }) => ({ name: label, href: href ?? `/verdicts/${tier.slug}` })),
  new URL(`/verdicts/${tier.slug}`, Astro.site ?? Astro.url).href,
);
---

<Layout title={`${tier.label} Verdict — The Official Ledger Registry`} description={`${tier.label}: ${tier.description}`}>
  <script slot="head" is:inline type="application/ld+json" set:html={serializeForScript(breadcrumbData)} />
  <PageRibbon
    icon={tier.icon}
    kicker="Official Verdict Classification"
    title={tier.label}
    quote={tier.motto}
    description={tier.description}
    bannerClass={tier.bannerClass}
  />

  <div class="w-full pt-6 sm:pt-8">
    <!-- Verdict Navigation Tabs: below the ribbon, edge to edge, fading out at both sides -->
    <div class="border-b border-hairline">
      <nav class="tier-nav-scroll pb-2" aria-label="Browse by verdict">
        {TIERS.map((t) => (
          <TierChip
            href={`/verdicts/${t.slug}`}
            name={t.label}
            color={t.color}
            glyph={t.glyph}
            count={tierCounts[t.value]}
            selected={t.value === tier.value}
          />
        ))}
      </nav>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 pt-8 pb-8 sm:pt-10 sm:pb-12 w-full space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Approved Verdict Michelin Star Style Prize Banner -->
    {tier.value === 'approved' && (
      <div class="bg-deep text-parchment-fixed p-6 sm:p-7 rounded-2xl shadow-xl flex flex-col sm:flex-row items-center gap-6 relative overflow-hidden">
        <div class="relative z-10 shrink-0">
          <img
            src="/brand/approved-sticker-256.webp" width="256" height="256"
            alt="Official MCR Lunch Club Approved Sticker"
            class="w-28 h-28 sm:w-32 sm:h-32 object-contain drop-shadow-[0_0_20px_rgba(197,155,39,0.4)] select-none hover:scale-105 transition-transform"
          />
        </div>
        <div class="space-y-2 text-center sm:text-left relative z-10">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <span class="text-xs uppercase tracking-widest text-gold font-sans tabular-nums font-bold">
              The Official Prize of Excellence
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            The MCR Lunch Club Approved Sticker
          </h2>
          <p class="text-xs sm:text-sm text-ash leading-relaxed">
            We hand these official physical stickers out as prizes to venues that meet our rigorous standards. Treated like Manchester’s own lunchtime Michelin star, only establishments that survive the Chairs’ inspection across multiple visits earn the right to display this badge of lunchtime honour.
          </p>
        </div>
        <Icon name="star" class="absolute -right-8 -bottom-10 text-white/5 pointer-events-none icon-watermark" />
      </div>
    )}

    <!-- Venue Grid -->
    <div class="space-y-4">
      <div class="space-y-2">
        <div class="border-b border-hairline pb-2 flex items-end justify-between gap-4">
          <div class="space-y-1">
            <h2 class="text-xl font-bold text-ink">Enrolled Establishments</h2>
            <p class="text-xs font-sans tabular-nums text-stone-500">Origin: Spinningfields Base Quorum</p>
          </div>
          <span class="bench-count shrink-0">{venues.length} {tier.label}</span>
        </div>
      </div>

      <div class="bench-pillars tier-venue-grid">
        {cards.map((card) => <BenchPillar pillar={card} />)}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getWalkingDirectionsUrl } from '@/lib/map/directions';
  import { enableHorizontalScroll } from '@/lib/horizontal-scroll';

  // Apple devices get Apple Maps, like the homepage walk links.
  document.querySelectorAll<HTMLAnchorElement>('a[data-walk-directions]').forEach((link) => {
    const lat = Number(link.dataset.lat);
    const lng = Number(link.dataset.lng);
    if (Number.isFinite(lat) && Number.isFinite(lng)) link.href = getWalkingDirectionsUrl(lat, lng);
  });

  // A mouse can't scroll the tier strip sideways without a visible scrollbar, so add wheel and drag.
  const nav = document.querySelector<HTMLElement>('.tier-nav-scroll');
  if (nav) enableHorizontalScroll(nav);
</script>
