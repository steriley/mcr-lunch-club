---
import ApprovedSticker from '@/components/ApprovedSticker.astro';
import Layout from '@/layouts/Layout.astro';
import TierChip from '@/components/TierChip.vue';
import BenchPillar from '@/components/BenchPillar.astro';
import PageRibbon from '@/components/PageRibbon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getPublicInspections, getPublicVenues, type PublicVenue } from '@/lib/public-data';
import { toCard } from '@/lib/sovereign-bench';
import { sortByRecentInspection } from '@/lib/venue-order';
import { breadcrumbStructuredData } from '@/lib/structured-data';
import { serializeForScript } from '@/lib/public-data';
import { TIERS, countVenuesByTier, type Tier } from '@/lib/tiers';
import type { Inspection } from '@/types';

// Built with the site; admin saves trigger a rebuild (src/lib/rebuild.ts).
// An unknown tier slug has no page, so it gets src/pages/404.astro.
export const prerender = true;

export async function getStaticPaths() {
  const [publicVenues, inspections] = await Promise.all([
    getPublicVenues(),
    getPublicInspections(),
  ]);
  return TIERS.map((tier) => ({
    params: { tier: tier.slug },
    props: { tier, publicVenues, inspections },
  }));
}

interface Props {
  tier: Tier;
  publicVenues: PublicVenue[];
  inspections: Inspection[];
}

const { tier, publicVenues, inspections } = Astro.props;
// Most recently inspected first, then A to Z.
const venues = sortByRecentInspection(
  publicVenues.filter((venue) => venue.tier === tier.value),
  inspections
);
const cards = venues.map((venue) => toCard({ venue }, inspections));
const tierCounts = countVenuesByTier(publicVenues);
const breadcrumbs = [
  { label: 'Map', href: '/' },
  { label: 'Verdicts', href: '/verdicts/approved' },
  { label: tier.label },
];
const breadcrumbData = breadcrumbStructuredData(
  breadcrumbs.map(({ label, href }) => ({ name: label, href: href ?? `/verdicts/${tier.slug}` })),
  new URL(`/verdicts/${tier.slug}`, Astro.site ?? Astro.url).href
);
---

<Layout
  title={`${tier.label} Verdict — The Official Ledger Registry`}
  description={`${tier.label}: ${tier.description}`}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={serializeForScript(breadcrumbData)}
  />
  <PageRibbon
    icon={tier.icon}
    iconClass="icon-banner-tier"
    kicker="Official Verdict Classification"
    title={tier.label}
    quote={tier.motto}
    description={tier.description}
    bannerClass={tier.bannerClass}
  />

  <div class="w-full pt-6 sm:pt-8">
    <!-- Verdict Navigation Tabs: below the ribbon, edge to edge, fading out at both sides -->
    <div class="border-b border-hairline">
      <nav class="tier-nav-scroll pb-2" aria-label="Browse by verdict">
        {TIERS.map((t) => (
          <TierChip
            href={`/verdicts/${t.slug}`}
            name={t.label}
            color={t.color}
            glyph={t.glyph}
            count={tierCounts[t.value]}
            selected={t.value === tier.value}
          />
        ))}
      </nav>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 pt-4 pb-8 sm:pt-6 sm:pb-12 w-full space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    {tier.value === 'approved' && <ApprovedSticker />}

    <!-- Venue Grid -->
    <div class="space-y-4">
      <div class="space-y-2">
        <div class="border-b border-hairline pb-2 flex items-end justify-between gap-4">
          <div class="space-y-1">
            <h2 class="text-xl font-bold text-ink">Enrolled Establishments</h2>
            <p class="text-xs font-sans tabular-nums text-stone-500">
              Most recently inspected first
            </p>
          </div>
          <span class="bench-count shrink-0">
            {venues.length} {tier.label}
          </span>
        </div>
      </div>

      <div class="bench-pillars tier-venue-grid">
        {cards.map((card) => (
          <BenchPillar pillar={card} />
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { enableHorizontalScroll } from '@/lib/horizontal-scroll';

  // A mouse can't scroll the tier strip sideways without a visible scrollbar, so add wheel and drag.
  const nav = document.querySelector<HTMLElement>('.tier-nav-scroll');
  if (nav) enableHorizontalScroll(nav);
</script>
