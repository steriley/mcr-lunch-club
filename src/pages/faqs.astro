---
import Layout from '@/layouts/Layout.astro';
import PageRibbon from '@/components/PageRibbon.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { FAQ_PARTS } from '@/data/faqs';

export const prerender = true;

const questionCount = FAQ_PARTS.reduce((total, part) => total + part.items.length, 0);
---

<Layout
  title="FAQs for Venues & the Merely Curious — MCR Lunch Club"
  description="Why a venue was rejected, how it gets on the list, and every other question the Chairs have been asked. Answers are final."
>
  <PageRibbon
    icon="scroll"
    kicker="Issued Under the Authority of the Chairs"
    title="Frequently Asked Questions"
    quote={[
      'For venues, proprietors, and the merely curious.',
      {
        text: 'Read in full before writing to us. Read in full again before writing to us angrily.',
        accent: true,
      },
    ]}
    width="max-w-4xl"
  />

  <div class="max-w-4xl mx-auto px-4 py-8 sm:py-12 w-full space-y-10">
    <Breadcrumbs items={[{ label: 'Map', href: '/' }, { label: 'FAQs' }]} />

    <!-- Jump list -->
    <nav
      aria-label="FAQ sections"
      class="bg-card rounded-2xl border border-hairline p-5 sm:p-6 shadow-sm space-y-3"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-hairline pb-2">
        <span class="text-xs uppercase tracking-widest font-bold text-stone-500">
          Table of Proceedings
        </span>
        <span class="text-xs tabular-nums text-stone-500">
          {questionCount} questions answered, none reconsidered
        </span>
      </div>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5">
        {FAQ_PARTS.map((part) => (
          <li>
            <a href={`#${part.id}`} class="faq-jump">
              <span class="faq-jump-numeral">{part.numeral}</span>
              <span>{part.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {FAQ_PARTS.map((part) => (
      <section id={part.id} class="space-y-5 scroll-mt-24" aria-labelledby={`${part.id}-heading`}>
        <div class="border-b border-hairline pb-2 space-y-1">
          <h2
            id={`${part.id}-heading`}
            class="text-2xl font-bold text-ink flex items-baseline gap-3"
          >
            <span class="text-sm font-sans tabular-nums uppercase tracking-widest text-stone-500 font-bold">
              Part {part.numeral}
            </span>
            <span>{part.title}</span>
          </h2>
          {part.intro && (
            <p class="text-sm italic text-stone-600 font-serif-header">{part.intro}</p>
          )}
        </div>

        <div class="space-y-3">
          {part.items.map((item) => (
            <details class="faq-item bg-card rounded-2xl border border-hairline shadow-sm">
              <summary class="faq-summary">
                <h3 class="faq-question">{item.q}</h3>
                <span class="faq-chevron" aria-hidden="true"></span>
              </summary>

              <div class="faq-body space-y-4">
                {item.a.map((paragraph) => (
                  <p
                    class="text-base text-stone-800 leading-relaxed max-w-[70ch]"
                    set:html={paragraph}
                  />
                ))}

                {item.table && (
                  <div class="overflow-x-auto rounded-xl border border-hairline">
                    <table class="faq-table">
                      <thead>
                        <tr>
                          {item.table.head.map((cell) => (
                            <th scope="col">{cell}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {item.table.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={cell} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {item.steps && (
                  <ol class="list-decimal pl-6 space-y-1 text-base text-stone-800 leading-relaxed max-w-[70ch]">
                    {item.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                )}

                {item.quote && (
                  <figure class="faq-quote">
                    <blockquote class="font-serif-header italic text-base sm:text-lg leading-snug text-ink max-w-[60ch]">
                      <p>
                        “<Fragment set:html={item.quote.text} />”
                      </p>
                    </blockquote>
                    <figcaption class="faq-quote-by">
                      <Icon name="scales" class="icon-sm" />
                      <span>{item.quote.chair}</span>
                    </figcaption>
                  </figure>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}

    <!-- Sign-off seal -->
    <div class="flex flex-col items-center text-center py-6 text-stone-600 text-xs space-y-1 border-t border-hairline">
      <Icon name="lock" class="icon-lg" />
      <div class="font-bold text-navy uppercase tracking-wider">
        Verdicts are final. Lunches are not.
      </div>
      <div class="font-serif-header italic text-stone-500">
        “We lunch with purpose. We judge with integrity. We return only where deserved.”
      </div>
    </div>
  </div>
</Layout>

<style>
  .faq-jump {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 4px 0;
    color: var(--color-navy);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .faq-jump:hover {
    text-decoration: underline;
  }

  .faq-jump-numeral {
    flex: none;
    min-width: 2.25em;
    color: var(--color-gold);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }

  .faq-item[open] {
    border-color: var(--color-hairline-strong);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    border-radius: 1rem;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }

  .faq-question {
    margin: 0;
    color: var(--color-navy);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    .faq-summary {
      padding: 18px 28px;
    }

    .faq-question {
      font-size: 1.15rem;
    }
  }

  .faq-chevron {
    flex: none;
    width: 9px;
    height: 9px;
    margin-right: 4px;
    border-right: 2px solid var(--color-gold);
    border-bottom: 2px solid var(--color-gold);
    transform: rotate(45deg);
    transition: transform 160ms ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(-135deg);
  }

  .faq-body {
    margin: 0 20px;
    padding: 16px 0 20px;
    border-top: 1px solid var(--color-hairline);
  }

  @media (min-width: 640px) {
    .faq-body {
      margin: 0 28px;
      padding-bottom: 24px;
    }
  }

  .faq-body :global(a) {
    color: var(--color-navy);
    font-weight: 700;
    text-decoration: underline;
  }

  .faq-quote {
    margin: 0;
    padding: 12px 16px;
    border-left: 3px solid var(--color-gold);
    border-radius: 0 0.75rem 0.75rem 0;
    background: var(--color-paper);
  }

  .faq-quote-by {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    color: var(--color-navy);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .faq-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .faq-table th {
    padding: 10px 14px;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-navy);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
  }

  .faq-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-hairline);
    vertical-align: top;
  }

  .faq-table tbody tr:last-child td {
    border-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
