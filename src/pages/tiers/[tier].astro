---
import Layout from '@/layouts/Layout.astro';
import venuesData from '@/data/venues.json';
import type { TierStatus } from '@/types';

export async function getStaticPaths() {
  const tiers: { slug: string; name: TierStatus }[] = [
    { slug: 'approved', name: 'Approved' },
    { slug: 'under-consideration', name: 'Under Consideration' },
    { slug: 'to-be-assessed', name: 'To Be Assessed' },
    { slug: 'if-we-must', name: 'If We Must' },
    { slug: 'rejected', name: 'Rejected' },
    { slug: 'gone-but-not-forgotten', name: 'Gone But Not Forgotten' },
  ];

  return tiers.map((t) => {
    const list = venuesData.filter((v) => v.status === t.name);
    return {
      params: { tier: t.slug },
      props: { tierName: t.name, venues: list, allTiers: tiers },
    };
  });
}

const { tierName, venues, allTiers } = Astro.props;
const currentTierSlug = Astro.params.tier;

const TIER_METADATA: Record<string, { bannerBg: string; quote: string; description: string; rule: string; icon: string }> = {
  'Approved': {
    bannerBg: 'bg-[#8b1e22]',
    icon: '🏆',
    quote: 'The Highest Honour in Manchester Lunching: The Right to be Returned To',
    description: 'Venue has survived the Chairs’ scrutiny by delivering consistent, good-value, characterful lunches across multiple visits. It has earned the highest honour in Manchester lunching: the right to be returned to.',
    rule: 'Each must be visited on at least two separate occasions and deliver satisfactory outcomes on both. Consistency is king.',
  },
  'Under Consideration': {
    bannerBg: 'bg-[#d97706]',
    icon: '⏳',
    quote: 'The Waiting Chamber of Judgement',
    description: 'Venue has shown enough promise to warrant serious attention, but has not yet earned a final verdict from the Chairs. It sits in the waiting chamber of judgement, pending further evidence, appetite, and official lunching scrutiny.',
    rule: 'Pending further evidence, appetite, and official lunching scrutiny.',
  },
  'To Be Assessed': {
    bannerBg: 'bg-[#2563eb]',
    icon: '📜',
    quote: 'Entered the Lunch Club’s Field of Vision',
    description: 'Venue has entered the Lunch Club’s field of vision, but has not yet faced the full judgement of the Chairs. Its fate remains undecided until proper inspection confirms whether it is worthy of approval, rejection, or reluctant tolerance.',
    rule: 'Fate remains undecided until proper inspection confirms whether it is worthy of approval, rejection, or reluctant tolerance.',
  },
  'If We Must': {
    bannerBg: 'bg-[#854d0e]',
    icon: '🌧',
    quote: 'Not Celebrated, But Tolerated',
    description: 'Venue is not celebrated, but tolerated: acceptable only when circumstance, convenience, or lack of better options forces the Club’s hand. It remains outside true approval, granted not honour, but reluctant permission.',
    rule: 'Acceptable only when circumstance, convenience, or lack of better options forces the Club’s hand.',
  },
  'Rejected': {
    bannerBg: 'bg-[#374151]',
    icon: '⛔',
    quote: 'Removed from the Sacred Lunch Rotation',
    description: 'Venue has failed to meet the standards of the Chairs, whether through poor value, weak quality, lack of character, or the unforgivable sin of inconsistency. It is removed from the sacred lunch rotation and may only return through exceptional redemption.',
    rule: 'Removed from the sacred lunch rotation and may only return through exceptional redemption.',
  },
  'Gone But Not Forgotten': {
    bannerBg: 'bg-[#78716c]',
    icon: '🕊',
    quote: 'Legend Remains in the Lunching Annals',
    description: 'Venue once held a place in the Club’s affections, but is no longer available to be judged, revisited, or relied upon. Its doors may be closed, but its legend remains in the lunching annals.',
    rule: 'Preserved in the lunching annals in perpetuity.',
  },
};

const meta = TIER_METADATA[tierName] || TIER_METADATA['Approved'];
---

<Layout title={`${tierName} Tier — The Official Ledger Registry`}>
  <div class="max-w-6xl mx-auto px-4 py-8 sm:py-12 w-full space-y-8 font-serif-header">
    <!-- Breadcrumbs & Manifesto Link -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <a href="/" class="text-[#8b1e22] hover:underline flex items-center gap-1 font-bold">
        <span>←</span>
        <span>Return to Sovereign Map</span>
      </a>
      <a href="/manifesto" class="text-stone-600 hover:text-[#8b1e22] flex items-center gap-1.5 underline decoration-[#c59b27] font-semibold">
        <span>📜</span>
        <span>Read The Official Manifesto</span>
      </a>
    </div>

    <!-- Tier Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-[#dcd6c8] text-xs">
      {allTiers.map((t) => (
        <a
          href={`/tiers/${t.slug}`}
          class={`px-3 py-1.5 rounded-full whitespace-nowrap transition-colors border font-serif-header ${t.slug === currentTierSlug ? 'bg-[#1a1e24] text-[#c59b27] border-[#c59b27] font-bold shadow-xs' : 'bg-white text-stone-700 hover:bg-stone-100 border-[#dcd6c8]'}`}
        >
          {t.name}
        </a>
      ))}
    </div>

    <!-- Tier Header Hero Card -->
    <div class={`${meta.bannerBg} text-white p-6 sm:p-8 rounded-2xl border-2 border-[#c59b27] shadow-xl space-y-4`}>
      <div class="flex items-center gap-3">
        <span class="text-3xl sm:text-4xl">{meta.icon}</span>
        <div>
          <span class="text-xs uppercase tracking-widest text-[#f9f7f1] font-bold font-mono">
            Official Tier Classification
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
            {tierName}
          </h1>
        </div>
      </div>

      <p class="text-base sm:text-lg italic text-[#f9f7f1] pt-1">
        “{meta.quote}”
      </p>

      <p class="text-xs sm:text-sm text-stone-200 font-sans max-w-3xl leading-relaxed pt-2 border-t border-white/20">
        {meta.description}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <div class="inline-flex items-center gap-2 bg-black/30 border border-white/20 px-3 py-1.5 rounded-lg text-xs font-sans text-amber-200">
          <strong>Constitutional Standard:</strong>
          <span>{meta.rule}</span>
        </div>

        {tierName === 'Approved' && (
          <div class="inline-flex items-center gap-2 bg-black/30 border border-white/20 px-3 py-1.5 rounded-lg text-xs font-sans text-stone-200">
            <strong class="text-[#c59b27] font-mono">Cost Key:</strong>
            <span>£ (under £10) &bull; ££ (above £10) &bull; £££ (payday treat)</span>
          </div>
        )}
      </div>
    </div>

    <!-- Rejected Venues Specific Censure Notice -->
    {tierName === 'Rejected' && (
      <div class="bg-[#1a1e24] text-[#f9f7f1] border-2 border-rose-800 p-6 rounded-2xl shadow-lg space-y-3 font-sans">
        <div class="flex items-center gap-2 text-rose-400 font-bold uppercase tracking-wider text-xs font-serif-header">
          <span class="text-lg">⛔</span>
          <span>Specific Rejection Decrees & Footnotes</span>
        </div>
        <p class="text-xs sm:text-sm text-stone-300">
          The following venues were formally removed from the rotation under specific inspection findings:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 font-serif-header">
          <div class="bg-rose-950/60 border border-rose-700/60 p-3 rounded-xl">
            <a href="/venues/pho-cue" class="font-bold text-white hover:text-amber-300 text-sm block">
              Pho Cue**
            </a>
            <span class="text-[11px] text-rose-300 font-sans block mt-1">Closed during inspections</span>
          </div>
          <div class="bg-rose-950/60 border border-rose-700/60 p-3 rounded-xl">
            <a href="/venues/sqew-shawarma-bar" class="font-bold text-white hover:text-amber-300 text-sm block">
              Sqew Shawarma Bar*
            </a>
            <span class="text-[11px] text-rose-300 font-sans block mt-1">Unacceptable drop in consistent quality</span>
          </div>
          <div class="bg-rose-950/60 border border-rose-700/60 p-3 rounded-xl">
            <a href="/venues/street-food-kitchen-by-eastzeast" class="font-bold text-white hover:text-amber-300 text-sm block">
              Street Food Kitchen by eastZeast**
            </a>
            <span class="text-[11px] text-rose-300 font-sans block mt-1">Closed during inspections</span>
          </div>
        </div>
        <div class="border-t border-white/10 pt-2 text-xs text-stone-400 space-y-0.5 font-mono italic">
          <div>* rejected due to an unacceptable drop in consistent quality</div>
          <div>** rejected due to being closed during inspections</div>
        </div>
      </div>
    )}

    <!-- Venue Grid -->
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#dcd6c8] pb-2 font-serif-header">
        <h2 class="text-xl font-bold text-[#1a1e24] flex items-center gap-2">
          <span>Enrolled Establishments</span>
          <span class="text-xs font-mono font-bold bg-[#8b1e22] text-white px-2 py-0.5 rounded">
            {venues.length} Venues
          </span>
        </h2>
        <span class="text-xs text-stone-500 font-sans">
          Origin: Spinningfields Base Quorum
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {venues.map((venue) => (
          <div class="bg-[#fdfcf9] rounded-xl border border-[#dcd6c8] shadow-sm hover:shadow-md transition-shadow p-5 flex flex-col justify-between font-sans">
            <div>
              <div class="flex items-start justify-between gap-2 border-b border-stone-100 pb-2 mb-2 font-serif-header">
                <div>
                  <div class="flex items-center gap-1.5">
                    {venue.rank && venue.status === 'Approved' && (
                      <span class="text-xs font-mono font-bold bg-[#c59b27] text-[#1a1e24] px-1.5 py-0.2 rounded">
                        #{venue.rank}
                      </span>
                    )}
                    <h3 class="font-bold text-base text-[#1a1e24] leading-snug">
                      {venue.name}
                    </h3>
                  </div>
                  <span class="text-[11px] text-stone-500 font-sans block mt-0.5">
                    {venue.cuisine}
                  </span>
                </div>

                <span class="font-mono font-bold text-sm text-[#8b1e22] bg-stone-100 px-2 py-0.5 rounded border border-stone-200">
                  {venue.cost}
                </span>
              </div>

              <!-- Distance / Walk time -->
              <div class="flex items-center justify-between text-xs text-stone-700 bg-[#f4efe4] p-2 rounded mb-3 font-mono">
                <span>🚶 {venue.walkingTimeMin} min walk</span>
                <span>📏 {venue.distanceMiles} miles</span>
              </div>

              <!-- Eat like us snippet -->
              <div class="text-xs text-stone-800 bg-amber-50/60 p-2.5 rounded border border-amber-200/60 mb-3">
                <strong class="font-serif-header text-[#8b1e22] text-[11px] block">Eat Like Us:</strong>
                <p class="italic text-[11px] text-stone-700 line-clamp-2 mt-0.5 font-serif-header">
                  “{venue.eatLikeUs}”
                </p>
              </div>

              {venue.rejectionReason && (
                <div class="text-[11px] text-rose-900 bg-rose-50 p-2 rounded border border-rose-200 mb-3">
                  <strong class="block">Censure Note:</strong>
                  <p class="italic line-clamp-2">{venue.rejectionReason}</p>
                </div>
              )}
            </div>

            <div class="pt-3 border-t border-stone-100 flex items-center justify-between gap-2 text-xs">
              <a
                href={`/venues/${venue.slug}`}
                class="flex-1 bg-[#1a1e24] hover:bg-[#8b1e22] text-white py-1.5 px-3 rounded font-serif-header font-semibold text-center transition-colors"
              >
                Dossier 📜
              </a>
              <a
                href={venue.mapSearchLink}
                target="_blank"
                class="p-1.5 text-stone-600 hover:text-stone-900 bg-white border border-[#dcd6c8] rounded text-center"
                title="Directions in Google Maps"
              >
                🧭
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
