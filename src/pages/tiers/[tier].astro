---
import Layout from '@/layouts/Layout.astro';
import TierChip from '@/components/TierChip.vue';
import { focalStyle } from '@/lib/image-upload';
import { getPublicVenues, setPublicCacheHeaders } from '@/lib/public-data';
import { milesText, walkText } from '@/lib/route-display';
import { TIERS, countVenuesByTier, tierFromSlug } from '@/lib/tiers';

export const prerender = false;

const tier = tierFromSlug(Astro.params.tier);
if (!tier) {
  // An empty 404 makes Astro render src/pages/404.astro.
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// getPublicVenues already returns each tier in its public order (src/lib/venue-order.ts).
const publicVenues = await getPublicVenues();
const venues = publicVenues.filter((venue) => venue.tier === tier.value);
const tierCounts = countVenuesByTier(publicVenues);
setPublicCacheHeaders(Astro.response.headers);
---

<Layout title={`${tier.label} Tier — The Official Ledger Registry`}>
  <div class="max-w-6xl mx-auto px-4 py-8 sm:py-12 w-full space-y-8 font-serif-header">
    <!-- Breadcrumbs & Manifesto Link -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <a href="/" class="text-[#8b1e22] hover:underline flex items-center gap-1 font-bold">
        <span>←</span>
        <span>Return to Sovereign Map</span>
      </a>
      <a href="/manifesto" class="text-stone-600 hover:text-[#8b1e22] flex items-center gap-1.5 underline decoration-[#c59b27] font-semibold">
        <span>📜</span>
        <span>Read The Official Manifesto</span>
      </a>
    </div>

    <!-- Tier Navigation Tabs -->
    <nav class="flex items-center gap-[7px] overflow-x-auto pb-2 border-b border-[#dcd6c8]" aria-label="Browse by verdict">
      {TIERS.map((t) => (
        <TierChip
          href={`/tiers/${t.slug}`}
          name={t.label}
          color={t.color}
          count={tierCounts[t.value]}
          selected={t.value === tier.value}
        />
      ))}
    </nav>

    <!-- Tier Header Hero Card -->
    <div class={`${tier.bannerClass} tier-header-gradient text-white p-6 sm:p-8 rounded-2xl border-2 border-[#c59b27] shadow-xl space-y-4`}>
      <div class="flex items-center gap-3">
        <span class="text-3xl sm:text-4xl">{tier.icon}</span>
        <div>
          <span class="text-xs uppercase tracking-widest text-[#f9f7f1] font-bold font-mono">
            Official Tier Classification
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
            {tier.label}
          </h1>
        </div>
      </div>

      <p class="text-base sm:text-lg italic text-[#f9f7f1] pt-1">
        “{tier.motto}”
      </p>

      <p class="text-xs sm:text-sm text-stone-200 font-sans max-w-3xl leading-relaxed pt-2 border-t border-white/20">
        {tier.description}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <div class="inline-flex items-center gap-2 bg-black/30 border border-white/20 px-3 py-1.5 rounded-lg text-xs font-sans text-amber-200">
          <strong>Constitutional Standard:</strong>
          <span class="text-base">{tier.rule}</span>
        </div>

        {tier.value === 'approved' && (
          <div class="inline-flex items-center gap-2 bg-black/30 border border-white/20 px-3 py-1.5 rounded-lg text-xs font-sans text-stone-200">
            <strong class="text-[#c59b27] font-mono">Cost Key:</strong>
            <span>£ (under £10) &bull; ££ (above £10) &bull; £££ (payday treat)</span>
          </div>
        )}
      </div>
    </div>

    <!-- Approved Tier Michelin Star Style Prize Banner -->
    {tier.value === 'approved' && (
      <div class="bg-[#1a1e24] text-[#f9f7f1] border-2 border-[#c59b27] p-6 sm:p-7 rounded-2xl shadow-xl flex flex-col sm:flex-row items-center gap-6 font-serif-header relative overflow-hidden">
        <div class="relative z-10 shrink-0">
          <img
            src="/brand/approved-sticker.png"
            alt="Official MCR Lunch Club Approved Sticker"
            class="w-28 h-28 sm:w-32 sm:h-32 object-contain drop-shadow-[0_0_20px_rgba(197,155,39,0.4)] select-none hover:scale-105 transition-transform"
          />
        </div>
        <div class="space-y-2 text-center sm:text-left relative z-10">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
            <span class="text-xs uppercase tracking-widest text-[#c59b27] font-mono font-bold">
              The Official Prize of Excellence
            </span>
            <span class="bg-[#8b1e22] text-white text-xs font-mono font-bold px-2 py-0.5 rounded uppercase">
              Manchester’s Lunch Star
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            The MCR Lunch Club Approved Sticker
          </h2>
          <p class="text-xs sm:text-sm text-stone-300 font-sans leading-relaxed">
            We hand these official physical stickers out as prizes to venues that meet our rigorous standards. Treated like Manchester’s own lunchtime Michelin star, only establishments that survive the Chairs’ inspection across multiple visits earn the right to display this badge of lunchtime honour.
          </p>
        </div>
        <div class="absolute -right-8 -bottom-10 text-8xl text-white/5 pointer-events-none select-none">
          ⭐
        </div>
      </div>
    )}

    <!-- Venue Grid -->
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#dcd6c8] pb-2 font-serif-header">
        <h2 class="text-xl font-bold text-[#1a1e24] flex items-center gap-2">
          <span>Enrolled Establishments</span>
          <span class="text-xs font-mono font-bold bg-[#8b1e22] text-white px-2 py-0.5 rounded">
            {venues.length} Venues
          </span>
        </h2>
        <span class="text-xs text-stone-500 font-sans">
          Origin: Spinningfields Base Quorum
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {venues.map((venue) => (
          <div class="bg-[#fdfcf9] rounded-xl border border-[#dcd6c8] shadow-sm hover:shadow-md transition-shadow p-5 flex flex-col justify-between font-sans">
            <div>
              {venue.image && (
                <img
                  src={venue.image.thumbUrl}
                  alt={venue.image.alt}
                  width="640"
                  height="427"
                  style={{ objectPosition: focalStyle(venue.image) }}
                  loading="lazy"
                  decoding="async"
                  class="mb-3 aspect-[3/2] h-auto w-full rounded-lg border border-[#dcd6c8] object-cover"
                />
              )}
              <div class="flex items-start justify-between gap-2 border-b border-stone-100 pb-2 mb-2 font-serif-header">
                <div>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <h3 class="font-bold text-base text-[#1a1e24] leading-snug">
                      {venue.name}
                    </h3>
                    {venue.tier === 'approved' && (
                      <img
                        src="/brand/approved-sticker.png"
                        alt="Approved Sticker Awarded"
                        class="w-5 h-5 object-contain inline-block shrink-0"
                        title="Official MCR Lunch Club Approved Sticker Awarded"
                      />
                    )}
                  </div>
                  <span class="text-xs text-stone-500 font-sans block mt-0.5">
                    {venue.cuisine}
                  </span>
                  {venue.closed && (
                    <span class="mt-1 inline-block rounded border border-stone-300 bg-stone-100 px-1.5 py-0.5 font-sans text-xs font-bold uppercase tracking-wider text-stone-600">
                      Permanently closed
                    </span>
                  )}
                </div>

                <span class="font-mono font-bold text-sm text-[#8b1e22] bg-stone-100 px-2 py-0.5 rounded border border-stone-200">
                  {venue.cost}
                </span>
              </div>

              <!-- Distance / Walk time -->
              <div class="flex items-center justify-between text-xs text-stone-700 bg-[#f4efe4] p-2 rounded mb-3 font-mono">
                <span>🚶 {walkText(venue.walkingTimeMin)}</span>
                <span>📏 {milesText(venue.distanceMiles)}</span>
              </div>

              <!-- Eat like us snippet -->
              <div class="text-xs text-stone-800 bg-amber-50/60 p-2.5 rounded border border-amber-200/60 mb-3">
                <strong class="font-serif-header text-[#8b1e22] text-xs block">Eat Like Us:</strong>
                <p class="italic text-xs text-stone-700 line-clamp-2 mt-0.5 font-serif-header">
                  “{venue.eatLikeUs}”
                </p>
              </div>
            </div>

            <div class="pt-3 border-t border-stone-100 flex items-center justify-between gap-2 text-xs">
              <a
                href={`/venues/${venue.slug}`}
                class="flex-1 bg-[#1a1e24] hover:bg-[#8b1e22] text-white py-1.5 px-3 rounded font-serif-header font-semibold text-center transition-colors"
              >
                Dossier 📜
              </a>
              <a
                href={venue.mapSearchLink}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 text-stone-600 hover:text-stone-900 bg-white border border-[#dcd6c8] rounded text-center"
                title="Directions in Google Maps"
                aria-label={`Directions to ${venue.name} in Google Maps`}
              >
                <span aria-hidden="true">🧭</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
