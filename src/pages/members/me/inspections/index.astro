---
import Layout from '@/layouts/Layout.astro';
import MemberInspectionHistory from '@/components/islands/MemberInspectionHistory.vue';
import { db } from '@/lib/db';
import { memberInspectionsApi } from '@/lib/member-inspections';

export const prerender = false;

// The member's own lunch logs (#137). The middleware has checked the flag and the member.
const logs = await memberInspectionsApi.listOwn(db, Astro.locals.user!.id);
const saved = Astro.url.searchParams.has('saved');
const updated = Astro.url.searchParams.has('updated');
const verified = Astro.url.searchParams.has('verified');
---

<Layout title="Your lunches — MCR Lunch Club" description="Your logged lunches." noindex>
  <section class="mx-auto flex w-full max-w-2xl flex-col gap-6 px-4 py-10">
    <div>
      <a href="/members/me" class="text-sm font-semibold text-navy hover:underline">
        ← Your account
      </a>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-3xl font-bold text-ink">Your lunches</h1>
        <a
          href="/log"
          class="inline-flex min-h-11 items-center rounded-lg bg-navy-fixed px-4 text-sm font-semibold text-white hover:bg-deep"
        >
          Log a lunch
        </a>
      </div>
      <p class="mt-2 text-sm text-soot">
        Your first lunch at a venue is provisional; it counts once you’ve been back on another day.
        You can edit or delete a lunch for 24 hours after logging it.
      </p>
    </div>
    {(saved || updated) && (
      <p
        role="status"
        class="rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700"
      >
        {updated ? 'Your lunch is updated.' : 'Your lunch is in the ledger.'}
        {verified && ' Verified on site.'}
      </p>
    )}
    <MemberInspectionHistory client:load logs={logs} />
  </section>
</Layout>
