---
import Layout from '@/layouts/Layout.astro';
import { formatDate } from '@/lib/dates';
import { focalStyle } from '@/lib/image-upload';
import { INSPECTION_KIND_LABELS, INSPECTION_OUTCOME_BADGE_CLASSES, INSPECTION_OUTCOME_LABELS } from '@/lib/inspection-display';
import { getPublicInspections, getPublicVenue, setPublicCacheHeaders } from '@/lib/public-data';
import { milesText, walkText } from '@/lib/route-display';
import { COST_LABELS } from '@/lib/cost-display';
import { tierInfo } from '@/lib/tiers';

export const prerender = false;

const venue = Astro.params.slug ? await getPublicVenue(Astro.params.slug) : null;
if (!venue) {
  // An empty 404 makes Astro render src/pages/404.astro.
  return new Response(null, { status: 404, statusText: 'Not found' });
}
setPublicCacheHeaders(Astro.response.headers);

const venueInspections = await getPublicInspections(venue.slug);

const tier = tierInfo(venue.tier);
---

<Layout title={`${venue.name} — Official Ledger Dossier | MCR Lunch Club`}>
  <article class="w-full font-serif-header">
      <!-- Status Banner: runs edge to edge, content stays within the page width -->
      <div class={`${tier.bannerClass} tier-header-gradient text-white`}>
        <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="text-3xl sm:text-4xl">{tier.icon}</span>
            <div>
              <div class="flex items-center gap-3">
                <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-[#f9f7f1]">
                  {tier.label}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-stone-200 italic mt-1 font-serif-header">
                “{tier.quote}”
              </p>
            </div>
          </div>

          <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto border-t sm:border-t-0 border-white/20 pt-3 sm:pt-0">
            <span class="text-2xl font-mono font-bold text-white">{venue.cost}</span>
            <span class="text-xs text-stone-200 font-sans uppercase tracking-wider font-semibold">
              {COST_LABELS[venue.cost]}
            </span>
          </div>
        </div>
      </div>

      <!-- Dossier Body Content -->
      <div class="max-w-4xl mx-auto px-4 pt-4 pb-8 sm:pt-5 sm:pb-12 space-y-6 text-[#1a1e24]">
        {venue.closed && (
          <p class="rounded-xl border-2 border-stone-400 bg-stone-100 px-4 py-3 font-sans text-sm font-bold uppercase tracking-wider text-stone-700">
            Permanently closed
          </p>
        )}
        <!-- Title & Location Bar -->
        <div class="border-b border-[#dcd6c8] pb-6">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#1a1e24]">
            {venue.name}
          </h1>

          <p class="text-sm text-stone-600 mt-2 font-sans flex items-center gap-2">
            <span>📍 {venue.address || 'Address unrecorded; approximate Manchester zone'}</span>
          </p>
        </div>

        {venue.image && (
          <img
            src={venue.image.url}
            alt={venue.image.alt}
            width={venue.image.width ?? undefined}
            height={venue.image.height ?? undefined}
            style={{ objectPosition: focalStyle(venue.image) }}
            loading="lazy"
            decoding="async"
            class="w-full max-h-96 object-cover rounded-xl border border-[#dcd6c8]"
          />
        )}

        {venue.pullQuote && (
          <blockquote class="border-l-4 border-[#c59b27] pl-5 py-1">
            <p class="text-2xl sm:text-3xl italic leading-snug text-[#1a1e24]">“{venue.pullQuote}”</p>
            <footer class="mt-2 text-xs font-sans uppercase tracking-widest text-stone-500">— The Chairs</footer>
          </blockquote>
        )}

        <!-- Official Approved Sticker Award Plaque (Manchester Michelin Star) -->
        {venue.tier === 'approved' && (
          <div class="bg-gradient-to-r from-[#1a1e24] via-[#242b35] to-[#1a1e24] text-[#f9f7f1] p-5 sm:p-6 rounded-2xl shadow-xl flex flex-col sm:flex-row items-center gap-5 font-serif-header relative overflow-hidden">
            <div class="shrink-0 relative z-10">
              <img
                src="/brand/approved-sticker.png"
                alt="Official MCR Lunch Club Approved Sticker"
                class="w-24 h-24 sm:w-28 sm:h-28 object-contain drop-shadow-[0_0_20px_rgba(197,155,39,0.45)] select-none hover:scale-105 transition-transform"
              />
            </div>
            <div class="space-y-1.5 text-center sm:text-left relative z-10">
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                MCR Lunch Club Approved Venue
              </h2>
              <p class="text-xs sm:text-sm text-stone-300 font-sans leading-relaxed">
                This establishment has been awarded the official <strong>MCR Lunch Club Approved sticker</strong>. Handed out as prizes by the Chairs to venues that meet our strict standards across at least two independent satisfactory audits — treated with the prestige of a Manchester lunching Michelin star.
              </p>
            </div>
            <div class="absolute -right-8 -bottom-10 text-8xl text-white/5 pointer-events-none select-none">
              ⭐
            </div>
          </div>
        )}

        <!-- Geographic & Walking Specifications -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-[#f4efe4] p-4 rounded-xl border border-[#dcd6c8] text-center">
          <div class="p-2">
            <span class="text-xs text-stone-600 uppercase tracking-wider block font-sans">Walk Duration</span>
            <span class="text-2xl font-bold text-[#8b1e22]">{walkText(venue.walkingTimeMin, 'mins')}</span>
            <span class="text-xs text-stone-500 block font-sans">from Spinningfields Base</span>
          </div>

          <div class="p-2 border-t sm:border-t-0 sm:border-l border-[#dcd6c8]">
            <span class="text-xs text-stone-600 uppercase tracking-wider block font-sans">Distance Vector</span>
            <span class="text-2xl font-bold text-stone-900">{milesText(venue.distanceMiles)}</span>
            {venue.lat !== null && venue.lng !== null && (
              <span class="text-xs text-stone-500 block font-sans">Centroid: {venue.lat.toFixed(5)}, {venue.lng.toFixed(5)}</span>
            )}
          </div>

          <div class="p-2 border-t sm:border-t-0 sm:border-l border-[#dcd6c8]">
            <span class="text-xs text-stone-600 uppercase tracking-wider block font-sans">Last Sovereign Audit</span>
            <span class="text-lg font-bold text-stone-800 font-mono mt-1 block">{formatDate(venue.lastInspectionDate, { fallback: 'Awaiting Assessment' })}</span>
            <span class="text-xs text-stone-500 block font-sans">Permanent Record</span>
          </div>
        </div>

        <!-- Eat Like Us Box (Wax Seal Styling) -->
        {venue.eatLikeUs && (
        <div class="relative bg-amber-50/90 border-2 border-[#c59b27] p-6 rounded-xl shadow-md">
          <div class="flex items-center gap-2 text-xs font-bold text-[#8b1e22] uppercase tracking-wider">
            <span>🛡</span>
            <span>Eat Like Us — Sovereign Order Mandate</span>
          </div>
          <p class="text-lg italic text-stone-900 mt-2 leading-relaxed">
            “{venue.eatLikeUs}”
          </p>
          <p class="text-xs text-stone-500 font-sans mt-2">
            Deviation from the recommended order during official club outings requires advance written sanction from the presiding Chair.
          </p>
        </div>
        )}

        <!-- Formal Inspection History Ledger -->
        <div class="border-t border-[#dcd6c8] pt-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold tracking-tight text-[#1a1e24] flex items-center gap-2">
              <span>📋</span>
              <span>Chronological Inspection Ledger</span>
            </h2>
            <span class="text-xs font-mono text-stone-500 bg-stone-100 px-2 py-0.5 rounded">
              {venueInspections.length} recorded visits
            </span>
          </div>

          {venueInspections.length === 0 ? (
            <div class="p-6 text-center bg-stone-50 rounded-xl border border-dashed border-stone-300 text-base text-stone-500 font-sans">
              No inspections on record for this venue yet. One is entered once two Chairs confirm the same day's visit.
            </div>
          ) : (
            <div class="space-y-3 font-sans">
              {venueInspections.map((insp) => (
                <div class="px-4 py-2.5 rounded-xl bg-white border border-[#dcd6c8] shadow-xs">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-mono text-xs font-bold text-stone-800">{formatDate(insp.date)}</span>
                    <div class="flex items-center gap-1.5">
                      {insp.outcome && (
                        <span class={`px-2 py-0.5 rounded text-xs font-bold uppercase font-mono border ${INSPECTION_OUTCOME_BADGE_CLASSES[insp.outcome]}`}>
                          {INSPECTION_OUTCOME_LABELS[insp.outcome]}
                        </span>
                      )}
                      <span class={`px-2 py-0.5 rounded text-xs font-bold uppercase font-mono ${insp.kind === 'verified' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-stone-100 text-stone-600 border border-stone-300'}`}>
                        {INSPECTION_KIND_LABELS[insp.kind]}
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
  </article>
</Layout>
