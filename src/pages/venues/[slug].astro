---
import Icon from '@/components/Icon.astro';
import ApprovedSticker from '@/components/ApprovedSticker.astro';
import Layout from '@/layouts/Layout.astro';
import BenchPillar from '@/components/BenchPillar.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { formatDate } from '@/lib/dates';
import { focalStyle, imageSrcset } from '@/lib/image-upload';
import {
  INSPECTION_KIND_LABELS,
  INSPECTION_OUTCOME_BADGE_CLASSES,
  INSPECTION_OUTCOME_LABELS,
} from '@/lib/inspection-display';
import {
  getPublicInspections,
  getPublicVenueDetails,
  serializeForScript,
  type PublicVenueDetail,
} from '@/lib/public-data';
import VenueRouteMap from '@/components/islands/VenueRouteMap.vue';
import PublicInspections from '@/components/islands/PublicInspections.vue';
import SwingOMeter from '@/components/islands/SwingOMeter.vue';
import { meterMode } from '@/lib/swing';
import { isLoggableVenue } from '@/lib/member-inspection-rules';
import { isMembersEnabled } from '@/lib/members/flag';
import { getPublicMapApiKey } from '@/lib/env';
import { getDrivingDirectionsUrl, getWalkingDirectionsUrl } from '@/lib/map/directions';
import { routeModeFor, walkText } from '@/lib/route-display';
import { COST_LABELS } from '@/lib/cost-display';
import { nearbyAlternatives } from '@/lib/nearby-venues';
import { toCard, type BenchCard } from '@/lib/sovereign-bench';
import { tierInfo } from '@/lib/tiers';
import { breadcrumbStructuredData, venueStructuredData } from '@/lib/structured-data';
import { safeWebsiteUrl, websiteHostname } from '@/lib/website';
import type { Inspection } from '@/types';

// Built with the site; admin saves trigger a rebuild (src/lib/rebuild.ts).
// A slug with no public venue has no page, so it gets src/pages/404.astro.
export const prerender = true;

export async function getStaticPaths() {
  // Two queries for every venue page, rather than two per page.
  const [venues, inspections] = await Promise.all([
    getPublicVenueDetails(),
    getPublicInspections(),
  ]);
  return venues.map((venue) => ({
    params: { slug: venue.slug },
    props: {
      venue,
      venueInspections: inspections.filter((inspection) => inspection.venueSlug === venue.slug),
      // Worked out here, where every venue is already loaded, so pages cost no extra queries.
      nearby: nearbyAlternatives(venue, venues).map((other) =>
        toCard({ venue: other }, inspections)
      ),
    },
  }));
}

interface Props {
  venue: PublicVenueDetail;
  /** Newest first, like getPublicInspections. */
  venueInspections: Inspection[];
  /** Up to three other open venues, nearest first. */
  nearby: BenchCard[];
}

const { venue, venueInspections, nearby } = Astro.props;

// People's Inspections (#137) exist only while the `members` flag is on at build time. The
// section fetches its logs when scrolled to; "Log a lunch" sends a signed-out visitor to sign in.
const membersEnabled = await isMembersEnabled().catch(() => false);
const canLog =
  membersEnabled &&
  isLoggableVenue({
    tier: venue.tier,
    latitude: venue.lat,
    longitude: venue.lng,
    closedAt: venue.closed ? 'closed' : null,
  });

// The People's Verdict (#138) is behind the same flag, and its section stays hidden until the venue
// has a quorum (the island reveals it); Gone But Not Forgotten and closed venues get none.
const hasSwingMeter =
  membersEnabled && meterMode({ tier: venue.tier, closed: venue.closed }).kind !== 'none';

const tier = tierInfo(venue.tier);
const hasLocation = venue.lat !== null && venue.lng !== null;
const websiteHref = venue.closed ? null : safeWebsiteUrl(venue.websiteUrl);
const websiteHost = websiteHostname(venue.websiteUrl);
const cuisine = venue.cuisine && venue.cuisine !== 'Other' ? venue.cuisine : null;
// Walk up to 30 minutes from HQ, drive beyond. The stored walking time decides, so every walk time
// on the site agrees with the button and the map.
const driving = routeModeFor(venue.walkingTimeMin) === 'drive';
// A line routed in the other mode (a stale one) is never drawn: no walking line under "Drive there".
const route = venue.route && venue.route.mode === (driving ? 'drive' : 'walk') ? venue.route : null;
const showMap = hasLocation && !venue.closed;
const routeCaption = !route
  ? 'Route not yet charted'
  : route.mode === 'drive'
    ? `Drive · ${route.durationMin} min from Spinningfields · ${walkText(venue.walkingTimeMin)}`
    : `Walk · ${route.durationMin} min from Spinningfields`;
const showActions = (hasLocation && !venue.closed) || websiteHref !== null || canLog;
// The link preview when someone drops this page into the lunch chat.
const walk =
  venue.walkingTimeMin == null ? null : `${walkText(venue.walkingTimeMin)} from Spinningfields`;
const pageDescription = truncate(
  [
    `${tier.label} by the MCR Lunch Club.`,
    [venue.cuisine, venue.cost, walk].filter(Boolean).join(' · ') + '.',
    venue.tier === 'approved' && venue.eatLikeUs && `Eat like us: ${venue.eatLikeUs}`,
  ]
    .filter(Boolean)
    .join(' '),
  200
);

// Search engines read the venue's address, price and cuisine from this.
// Main photo: preloaded from the head so the request starts during the HTML parse (LCP).
const photoSrcset = venue.image ? imageSrcset(venue.image) : undefined;
const PHOTO_SIZES = '(min-width: 896px) 864px, calc(100vw - 2rem)';

const structuredData = venueStructuredData(
  venue,
  new URL(`/venues/${venue.slug}`, Astro.site ?? Astro.url).href
);
const breadcrumbs = [
  { label: 'Map', href: '/' },
  { label: 'Verdicts', href: '/verdicts/approved' },
  { label: tier.label, href: `/verdicts/${tier.slug}` },
  { label: venue.name },
];
const breadcrumbData = breadcrumbStructuredData(
  breadcrumbs.map(({ label, href }) => ({ name: label, href: href ?? `/venues/${venue.slug}` })),
  new URL(`/venues/${venue.slug}`, Astro.site ?? Astro.url).href
);

function truncate(text: string, max: number): string {
  return text.length <= max ? text : `${text.slice(0, max - 1).trimEnd()}…`;
}
---

<Layout
  title={`${venue.name} — Official Ledger Dossier | MCR Lunch Club`}
  description={pageDescription}
  image={venue.image?.url ?? `/og/venues/${venue.slug}.png`}
>
  {venue.image && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={venue.image.url}
      imagesrcset={photoSrcset}
      imagesizes={photoSrcset ? PHOTO_SIZES : undefined}
      fetchpriority="high"
    />
  )}
  {structuredData && (
    <script
      slot="head"
      is:inline
      type="application/ld+json"
      set:html={serializeForScript(structuredData)}
    />
  )}
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={serializeForScript(breadcrumbData)}
  />
  <article class="w-full">
    <!-- Status Banner: runs edge to edge, content stays within the page width -->
    <div class={`${tier.bannerClass} tier-header-gradient text-white`}>
      <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <Icon name={tier.icon} class="icon-banner-tier" />
          <div>
            <div class="flex items-center gap-3">
              <a
                href={`/verdicts/${tier.slug}`}
                class="tier-banner-link text-xs sm:text-sm font-bold uppercase tracking-widest text-parchment-fixed underline decoration-white/40 underline-offset-4 hover:decoration-white"
              >
                {tier.label}
                <span class="sr-only">: see all {tier.label} venues</span>
              </a>
            </div>
            <p class="text-xs sm:text-sm text-mist italic mt-1">“{tier.quote}”</p>
          </div>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto border-t sm:border-t-0 border-white/20 pt-3 sm:pt-0">
          <span class="text-2xl font-sans tabular-nums font-bold text-white">{venue.cost}</span>
          <span class="text-xs text-mist font-sans uppercase tracking-wider font-semibold">
            {COST_LABELS[venue.cost]}
          </span>
        </div>
      </div>
    </div>

    <!-- Dossier Body Content -->
    <div class="max-w-4xl mx-auto px-4 pt-4 pb-8 sm:pt-5 sm:pb-12 space-y-6 text-ink">
      <Breadcrumbs items={breadcrumbs} />
      {venue.closed && (
        <p class="rounded-xl border-2 border-neutral-edge-strong bg-neutral-wash px-4 py-3 font-sans text-sm font-bold uppercase tracking-wider text-soot">
          Permanently closed
        </p>
      )}
      <!-- Title & Location Bar -->
      <div class="border-b border-hairline pb-6">
        <div class="flex items-start justify-between gap-3">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">{venue.name}</h1>
          <!-- Installed apps have no address bar to copy from. -->
          <button
            type="button"
            class="copy-link"
            data-copy-link
            aria-label={`Copy link to ${venue.name}`}
          >
            <Icon name="link" class="copy-link-idle" />
            <Icon name="check" class="copy-link-done" />
          </button>
        </div>
        <p class="sr-only" role="status" data-copy-link-status></p>

        <p class="text-sm text-graphite mt-2 font-sans flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="pin" class="icon-md" />
            {venue.address || 'Address unrecorded; approximate Manchester zone'}
          </span>
          {cuisine && (
            <span class="text-dim">
              <span aria-hidden="true">·</span> <span class="sr-only">Cuisine: </span>
              {cuisine}
            </span>
          )}
        </p>

        {showActions && (
          <div class="dossier-actions">
            {hasLocation && !venue.closed && (
              <>
                {driving ? (
                  <a
                    class="dossier-action is-primary"
                    href={getDrivingDirectionsUrl(venue.lat!, venue.lng!, 'server')}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-drive-directions
                    data-lat={venue.lat}
                    data-lng={venue.lng}
                  >
                    <Icon name="directions_car" />
                    Drive there
                    {route && ` · ${route.durationMin} min`}
                  </a>
                ) : (
                  <a
                    class="dossier-action is-primary"
                    href={getWalkingDirectionsUrl(venue.lat!, venue.lng!, 'server')}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-walk-directions
                    data-lat={venue.lat}
                    data-lng={venue.lng}
                  >
                    <Icon name="directions_walk" />
                    Walk there
                    {venue.walkingTimeMin !== null && ` · ${walkText(venue.walkingTimeMin)}`}
                  </a>
                )}
                <a class="dossier-action" href={`/?venue=${encodeURIComponent(venue.slug)}`}>
                  <Icon name="explore" />
                  Show on the map
                </a>
              </>
            )}
            {websiteHref && (
              <a
                class="dossier-action"
                href={websiteHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="open_in_new" />
                Website<span class="sr-only"> ({websiteHost}, opens in a new tab)</span>
              </a>
            )}
            {canLog && (
              <a class="dossier-action" href={`/log/${encodeURIComponent(venue.slug)}`}>
                <Icon name="restaurant" />
                Log your lunch
              </a>
            )}
          </div>
        )}
      </div>

      {venue.tier === 'approved' && <ApprovedSticker variant="compact" />}

      {venue.image && (
        <img
          src={venue.image.url}
          srcset={photoSrcset}
          sizes={photoSrcset ? PHOTO_SIZES : undefined}
          alt={venue.image.alt}
          width={venue.image.width ?? undefined}
          height={venue.image.height ?? undefined}
          style={{ objectPosition: focalStyle(venue.image) }}
          fetchpriority="high"
          decoding="async"
          onerror="this.remove()"
          class="w-full max-h-96 object-cover rounded-xl border border-hairline bg-paper"
        />
      )}

      <!-- Eat Like Us Box (Wax Seal Styling) -->
      {venue.tier === 'approved' && venue.eatLikeUs && (
        <div class="relative bg-ochre-wash/90 border-2 border-gold p-6 rounded-xl shadow-md">
          <div class="flex items-center gap-2 text-xs font-bold text-navy uppercase tracking-wider">
            <Icon name="shield" class="icon-md" />
            <span>Eat like us — what to order</span>
          </div>
          <p class="text-lg italic text-ink mt-2 leading-relaxed">“{venue.eatLikeUs}”</p>
        </div>
      )}

      {showMap && (
        <section class="space-y-3" aria-labelledby="route-heading">
          <h2
            id="route-heading"
            class="text-xl font-bold tracking-tight text-ink flex items-center gap-2"
          >
            <Icon name={driving ? 'directions_car' : 'directions_walk'} class="icon-md" />
            <span>Getting there</span>
          </h2>
          <VenueRouteMap
            client:visible
            venue={venue}
            route={route}
            label={`Map from Lunch Club HQ in Spinningfields to ${venue.name}. ${routeCaption}.`}
            mapApiKey={getPublicMapApiKey()}
          />
        </section>
      )}

      {venue.pullQuote && (
        <blockquote class="border-l-4 border-gold pl-5 py-1">
          <p class="font-serif-header text-2xl sm:text-3xl italic leading-snug text-ink">
            “{venue.pullQuote}”
          </p>
          <footer class="mt-2 text-xs font-sans uppercase tracking-widest text-dim">
            — The Chairs
          </footer>
        </blockquote>
      )}

      {hasSwingMeter && (
        <section class="space-y-3" aria-labelledby="swing-heading" hidden>
          <h2
            id="swing-heading"
            class="text-xl font-bold tracking-tight text-ink flex items-center gap-2"
          >
            <Icon name="scales" class="icon-md" />
            <span>The People’s Verdict</span>
          </h2>
          <SwingOMeter client:idle slug={venue.slug} />
        </section>
      )}

      <!-- Formal Inspection History Ledger -->
      <div class="border-t border-hairline pt-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold tracking-tight text-ink flex items-center gap-2">
            <Icon name="clipboard" class="icon-md" />
            <span>Inspection Ledger</span>
          </h2>
          <span class="bench-count shrink-0 whitespace-nowrap">
            {venueInspections.length} {venueInspections.length === 1 ? 'Inspection' : 'Inspections'}
          </span>
        </div>

        {venueInspections.length === 0 ? (
          <div class="p-6 text-center bg-ivory rounded-xl border border-dashed border-hairline text-sm text-dim font-sans">
            No inspections on record for this venue yet. One is entered once two Chairs confirm the
            same day's visit.
          </div>
        ) : (
          <div class="space-y-3 font-sans">
            {venueInspections.map((insp) => (
              <div class="px-4 py-2.5 rounded-xl bg-surface border border-hairline shadow-xs">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-sans tabular-nums text-xs font-bold text-ink-soft whitespace-nowrap">
                    {formatDate(insp.date)}
                  </span>
                  <div class="flex items-center gap-1.5">
                    {insp.outcome && (
                      <span
                        class={`px-2 py-0.5 rounded text-xs font-bold uppercase font-sans tabular-nums border ${INSPECTION_OUTCOME_BADGE_CLASSES[insp.outcome]}`}
                      >
                        {INSPECTION_OUTCOME_LABELS[insp.outcome]}
                      </span>
                    )}
                    {insp.kind === 'legacy' && (
                      <span class="px-2 py-0.5 rounded text-xs font-bold uppercase font-sans tabular-nums bg-neutral-wash text-graphite border border-neutral-edge">
                        {INSPECTION_KIND_LABELS[insp.kind]}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {membersEnabled && (
        <section
          class="border-t border-hairline pt-6 space-y-4"
          aria-labelledby="public-inspections-heading"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2
              id="public-inspections-heading"
              class="text-xl font-bold tracking-tight text-ink flex items-center gap-2"
            >
              <Icon name="plate" class="icon-md" />
              <span>Recent inspections from the public</span>
            </h2>
            {canLog && (
              <a
                class="dossier-action"
                href={`/log/${encodeURIComponent(venue.slug)}`}
                data-log-lunch
              >
                <Icon name="restaurant" />
                Log your lunch
              </a>
            )}
          </div>
          <PublicInspections client:visible slug={venue.slug} venueName={venue.name} />
        </section>
      )}

      {nearby.length > 0 && (
        <section class="border-t border-hairline pt-6 space-y-4" aria-labelledby="nearby-heading">
          <h2
            id="nearby-heading"
            class="text-xl font-bold tracking-tight text-ink flex items-center gap-2"
          >
            <Icon name="explore" class="icon-md" />
            <span>Nearby</span>
          </h2>
          <div class="bench-pillars tier-venue-grid">
            {nearby.map((card) => (
              <BenchPillar pillar={card} />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const status = document.querySelector<HTMLElement>('[data-copy-link-status]');

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Insecure contexts and some webviews have no async clipboard.
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.append(field);
      field.select();
      try {
        return document.execCommand('copy');
      } catch {
        return false;
      } finally {
        field.remove();
      }
    }
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  button?.addEventListener('click', async () => {
    const url = new URL(location.href);
    url.hash = '';
    const ok = await copyText(url.href);
    if (status) status.textContent = ok ? 'Link copied' : 'Could not copy the link';
    if (!ok) return;
    button.classList.add('is-copied');
    clearTimeout(timer);
    timer = setTimeout(() => {
      button.classList.remove('is-copied');
      if (status) status.textContent = '';
    }, 2000);
  });
</script>
