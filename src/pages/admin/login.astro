---
import Layout from '@/layouts/Layout.astro';
import LoginForm from '@/components/islands/LoginForm.vue';
import { getPasskeyEnvironment } from '@/lib/env';
import { safeAdminRedirect } from '@/lib/safe-redirect';

export const prerender = false;

const next = safeAdminRedirect(Astro.url.searchParams.get('next'));
const { host: passkeyHost } = getPasskeyEnvironment();
---

<Layout
  title="Sign in — Chairs' Area"
  description="Sign in to the MCR Lunch Club Chairs' Area."
  noindex
>
  <section class="mx-auto flex w-full max-w-5xl flex-1 items-center justify-center px-4 py-12">
    <LoginForm client:load next={next} passkeyHost={passkeyHost} />
  </section>
</Layout>
