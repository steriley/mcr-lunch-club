---
import { auth } from '@/lib/auth';
import { db, schema } from '@/lib/db';
import AdminLayout from '@/layouts/AdminLayout.astro';

const user = Astro.locals.user;
const session = Astro.locals.session;
const { venues, briberyRecords } = schema;

const venueRows = await db.select().from(venues);
const briberyRows = await db.select().from(briberyRecords);
const userList = await auth.api.listUsers({
  headers: Astro.request.headers,
  query: { limit: 200, sortBy: 'createdAt', sortDirection: 'desc' },
});

const approvedCount = venueRows.filter((venue) => venue.published && venue.tier === 'approved').length;
const draftCount = venueRows.filter((venue) => !venue.published).length;
const briberyCount = briberyRows.length;
const chairCount = userList.users.length;

const dashboardStats = [
  { label: 'Published venues', value: String(approvedCount), tone: 'bg-[#E8F5EE] text-[#1E7A4E]' },
  { label: 'Drafts', value: String(draftCount), tone: 'bg-[#fff4df] text-[#C27803]' },
  { label: 'Bribery records', value: String(briberyCount), tone: 'bg-[#FDECEC] text-[#B92B27]' },
  { label: 'Chairs', value: String(chairCount), tone: 'bg-[#edf3ff] text-[#1B2F6B]' },
];
---

<AdminLayout title="Dashboard — Chairs' Area" userName={user?.name ?? 'Chair'}>
  <div class="space-y-6">
    <div class="rounded-2xl border border-[#d9cfb8] bg-[#f9f7f1] p-6 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8a5100]">Overview</p>
      <h1 class="mt-2 text-3xl font-bold text-[#1a1e24]">Welcome back, {user?.name ?? 'Chair'}.</h1>
      <p class="mt-3 max-w-2xl text-sm text-[#3d3d3d]">
        The ledger, verdicts and venue records are ready for review. Use the navigation above to manage the latest edits, inspections and chair account access.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {dashboardStats.map((stat) => (
        <div class="rounded-2xl border border-[#d9cfb8] bg-[#f9f7f1] p-5 shadow-sm">
          <div class:list={[stat.tone, 'inline-flex rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-[0.12em]']}>
            {stat.label}
          </div>
          <div class="mt-4 text-3xl font-bold text-[#1a1e24]">{stat.value}</div>
        </div>
      ))}
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.6fr_1fr]">
      <div class="rounded-2xl border border-[#d9cfb8] bg-[#f9f7f1] p-6 shadow-sm">
        <h2 class="text-xl font-bold text-[#1a1e24]">Recent chair activity</h2>
        <ul class="mt-4 space-y-3 text-sm text-[#2d2d2d]">
          <li class="border-b border-[#eadfca] pb-2">Review the latest venue edits and publish approvals from the ledger.</li>
          <li class="border-b border-[#eadfca] pb-2">Check new bribery and impropriety records for follow-up and resolution.</li>
          <li>Ensure the current chair roster is active and not blocked by bans or resets.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-[#d9cfb8] bg-[#f9f7f1] p-6 shadow-sm">
        <h2 class="text-xl font-bold text-[#1a1e24]">Session</h2>
        <dl class="mt-4 space-y-2 text-sm text-[#2d2d2d]">
          <div class="flex justify-between gap-4">
            <dt class="font-semibold">User</dt>
            <dd>{user?.email ?? 'Chair'}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="font-semibold">Role</dt>
            <dd>{session?.user.role ?? 'admin'}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="font-semibold">Session</dt>
            <dd>{session?.session.id ? 'Active' : 'Unavailable'}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</AdminLayout>
