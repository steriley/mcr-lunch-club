---
import { count, desc, eq, not } from 'drizzle-orm';
import NotificationPrompt from '@/components/admin/NotificationPrompt.vue';
import TierBadge from '@/components/admin/TierBadge.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { user } from '@/db/auth-schema';
import { tierProposals, venueSuggestions, venues } from '@/db/schema';
import { formatDateTime } from '@/lib/dates';
import { db } from '@/lib/db';
import { getPushEnvironment } from '@/lib/env';
import { listPendingInspections } from '@/lib/inspections';
import { getPreferences, listDevices } from '@/lib/push/store';
import { isPubliclyVisible } from '@/lib/visibility';
import { publicVenueCondition } from '@/lib/visibility-sql';

export const prerender = false;

const currentUser = Astro.locals.user;

const [hiddenVenues, recent, [suggestions], [pendingChanges], pendingInspections] =
  await Promise.all([
    db
      .select({ id: venues.id, name: venues.name, tier: venues.tier, updatedAt: venues.updatedAt })
      .from(venues)
      .where(not(publicVenueCondition()))
      .orderBy(desc(venues.updatedAt))
      .limit(10),
    db
      .select({
        id: venues.id,
        name: venues.name,
        tier: venues.tier,
        latitude: venues.latitude,
        longitude: venues.longitude,
        closedAt: venues.closedAt,
        updatedAt: venues.updatedAt,
        editor: user.name,
      })
      .from(venues)
      .leftJoin(user, eq(user.id, venues.updatedBy))
      .orderBy(desc(venues.updatedAt))
      .limit(8),
    db.select({ total: count() }).from(venueSuggestions).where(eq(venueSuggestions.status, 'new')),
    db.select({ total: count() }).from(tierProposals).where(eq(tierProposals.status, 'pending')),
    listPendingInspections(db, currentUser!.id),
  ]);

// A one-time nudge towards notifications, for a Chair with no device subscribed (#115).
const showNotificationPrompt =
  currentUser && getPushEnvironment()
    ? await Promise.all([listDevices(db, currentUser.id), getPreferences(db, currentUser.id)])
        .then(([devices, preferences]) => devices.length === 0 && !preferences.promptDismissed)
        .catch(() => false)
    : false;

const stats = [
  {
    label: 'Awaiting countersign',
    value: pendingChanges.total + pendingInspections.length,
    href: '/admin/pending',
    tone: 'bg-warning-tint text-ochre-fixed',
  },
  {
    label: 'New suggestions',
    value: suggestions.total,
    href: '/admin/suggestions',
    tone: 'bg-plum-tint text-plum',
  },
];
---

<AdminLayout title="Dashboard">
  <div class="space-y-6">
    <h1 class="sr-only">Overview</h1>

    {showNotificationPrompt && <NotificationPrompt client:load />}

    <div class="grid grid-cols-2 gap-2.5 sm:gap-4">
      {stats.map((stat) => (
        <a
          href={stat.href}
          class="block overflow-hidden rounded-xl border border-hairline bg-parchment shadow-sm transition hover:border-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-navy sm:rounded-2xl"
        >
          <span
            class:list={[
              stat.tone,
              'font-serif-header block px-3 py-1.5 text-[10px] font-bold uppercase leading-tight tracking-[0.1em] sm:px-5 sm:py-2 sm:text-xs sm:tracking-[0.12em]',
            ]}
          >
            {stat.label}
          </span>
          <span class="block px-3 py-2 text-2xl font-bold text-ink sm:px-5 sm:py-4 sm:text-3xl">
            {stat.value}
          </span>
        </a>
      ))}
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <section
        class="rounded-2xl border border-hairline bg-parchment p-6 shadow-sm"
        aria-labelledby="recent-heading"
      >
        <h2
          id="recent-heading"
          class="font-serif-header border-b border-hairline pb-2 text-xs font-bold uppercase leading-snug tracking-[0.055em] text-ochre"
        >
          Recently edited
        </h2>
        <ul class="mt-4 divide-y divide-sand text-sm">
          {recent.map((venue) => (
            <li class="py-2">
              <div class="flex items-center justify-between gap-3">
                <a
                  href={`/admin/venues/${venue.id}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {venue.name}
                </a>
                {!isPubliclyVisible(venue) && (
                  <span class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-600">
                    Hidden
                  </span>
                )}
              </div>
              <p class="text-xs text-graphite">
                {formatDateTime(venue.updatedAt)}
                {venue.editor ? ` by ${venue.editor}` : ''}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section
        class="rounded-2xl border border-hairline bg-parchment p-6 shadow-sm"
        aria-labelledby="drafts-heading"
      >
        <h2
          id="drafts-heading"
          class="font-serif-header border-b border-hairline pb-2 text-xs font-bold uppercase leading-snug tracking-[0.055em] text-ochre"
        >
          Hidden from the public site
        </h2>
        <p class="mt-2 text-xs text-graphite">Venues without an approved verdict or a location.</p>
        {hiddenVenues.length === 0 ? (
          <p class="mt-4 text-sm text-soot">Nothing hidden. Every venue is on the public site.</p>
        ) : (
          <ul class="mt-4 divide-y divide-sand text-sm">
            {hiddenVenues.map((venue) => (
              <li class="flex items-center justify-between gap-3 py-2">
                <a
                  href={`/admin/venues/${venue.id}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {venue.name}
                </a>
                <TierBadge tier={venue.tier} />
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</AdminLayout>
