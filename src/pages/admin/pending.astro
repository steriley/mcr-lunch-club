---
import AdminLayout from '@/layouts/AdminLayout.astro';
import TierTransition from '@/components/admin/TierTransition.astro';
import PendingDocket from '@/components/admin/pending/PendingDocket.vue';
import { db } from '@/lib/db';
import { formatDate, formatDateTime } from '@/lib/dates';
import {
  describeInspection,
  latestVerifiedInspection,
  listPendingInspections,
} from '@/lib/inspections';
import { londonDate } from '@/lib/london-date';
import { buildPendingEntries } from '@/lib/pending-docket';
import {
  countActiveAdmins,
  listPendingProposals,
  listRecentDecisions,
  serializeProposal,
} from '@/lib/tier-proposals';
import { listVisitsForInspections } from '@/lib/visits';

export const prerender = false;

const currentUserId = Astro.locals.user!.id;
const [proposals, inspections, recent, activeAdmins] = await Promise.all([
  listPendingProposals(db),
  listPendingInspections(db, currentUserId),
  listRecentDecisions(db),
  countActiveAdmins(db),
]);
const venueIds = [...new Set([...proposals, ...inspections].map((item) => item.venueId))];
const [latestByVenue, visitsByInspection] = await Promise.all([
  Promise.all(
    venueIds.map(async (venueId) => {
      const inspection = await latestVerifiedInspection(db, venueId);
      return [
        venueId,
        inspection
          ? `${formatDate(inspection.inspectionDate)}, ${describeInspection(inspection).replace(/^V/, 'v')}`
          : null,
      ] as const;
    })
  ).then((pairs) => new Map(pairs)),
  // The field notes behind today's unsigned inspections and each motion's cited inspection.
  listVisitsForInspections(db, [
    ...inspections.map((item) => item.inspectionId),
    ...proposals.flatMap((proposal) => (proposal.inspectionId ? [proposal.inspectionId] : [])),
  ]),
]);
const entries = buildPendingEntries(
  inspections,
  proposals.map((proposal) => ({ ...serializeProposal(proposal), venueName: proposal.venueName })),
  latestByVenue,
  visitsByInspection,
  currentUserId
);

/** How a proposal ended, worded for the line under its verdict change. */
function outcomeText(proposal: (typeof recent)[number]): string {
  const by = proposal.decidedByName ? ` by ${proposal.decidedByName}` : '';
  switch (proposal.status) {
    case 'approved':
      return `Approved${by}`;
    case 'declined':
      return `Declined${by}`;
    case 'withdrawn':
      return 'Withdrawn by its proposer';
    case 'superseded':
      return 'Replaced by a newer proposal';
    default:
      return proposal.status;
  }
}
---

<AdminLayout title="Pending countersignatures">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Inbox</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">Awaiting a second Chair</h1>
      <p class="mt-2 max-w-3xl text-sm text-graphite">
        Inspections and verdict changes both need a second Chair. An inspection must be cosigned the
        same day (UK time) or it lapses at midnight.
      </p>
    </div>

    {activeAdmins < 2 && (
      <p
        role="status"
        class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800"
      >
        Only {activeAdmins} active admin{activeAdmins === 1 ? '' : 's'}. A second active admin is
        required before anything can be approved; there is no override.
      </p>
    )}

    <section aria-labelledby="pending-heading" class="dossier space-y-3">
      <h2
        id="pending-heading"
        class="font-serif-header border-b border-hairline pb-2 text-xs font-bold uppercase leading-snug tracking-[0.055em] text-ochre"
      >
        Awaiting a decision
      </h2>
      <PendingDocket
        client:load
        entries={entries}
        currentUserId={currentUserId}
        activeAdmins={activeAdmins}
        today={londonDate()}
      />
    </section>

    <section
      class="overflow-hidden rounded-2xl border border-hairline bg-parchment p-6 shadow-sm"
      aria-labelledby="recent-heading"
    >
      <h2
        id="recent-heading"
        class="font-serif-header border-b border-hairline pb-2 text-xs font-bold uppercase leading-snug tracking-[0.055em] text-ochre"
      >
        Recently decided
      </h2>
      {recent.length === 0 ? (
        <p class="mt-4 text-sm text-soot">No decisions yet.</p>
      ) : (
        <ul class="mt-4 divide-y divide-sand text-sm">
          {recent.map((proposal) => (
            <li class="space-y-2 py-3">
              <a
                href={`/admin/venues/${proposal.venueId}`}
                class="block font-semibold text-ink hover:underline"
              >
                {proposal.venueName}
              </a>
              <TierTransition from={proposal.fromTier} to={proposal.proposedTier} />
              <div class="space-y-0.5 text-graphite">
                <p>Proposed by {proposal.proposedByName ?? 'a former admin'}</p>
                <p>
                  <span class="font-semibold text-soot">{outcomeText(proposal)}</span>
                  {proposal.decidedAt ? ` on ${formatDateTime(proposal.decidedAt)}` : ''}
                </p>
              </div>
              {proposal.declineReason && <p class="text-soot">Reason: {proposal.declineReason}</p>}
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</AdminLayout>
