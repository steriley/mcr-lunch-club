---
import { eq } from 'drizzle-orm';
import VenueClosure from '@/components/islands/VenueClosure.vue';
import VenueForm from '@/components/islands/VenueForm.vue';
import VisitedToday from '@/components/islands/VisitedToday.vue';
import TierProposalPanel from '@/components/islands/TierProposalPanel.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { user } from '@/db/auth-schema';
import { venues } from '@/db/schema';
import { uuidParam } from '@/lib/admin-api';
import { formatDate } from '@/lib/dates';
import { db } from '@/lib/db';
import { getBlobToken } from '@/lib/env';
import { describeInspection, getVisitStatus, latestVerifiedInspection, listConfirmedInspections } from '@/lib/inspections';
import { countActiveAdmins, pendingProposalForVenue, serializeProposal } from '@/lib/tier-proposals';
import { serializeVenue } from '@/lib/venues';
import { hiddenReason } from '@/lib/visibility';

export const prerender = false;

const id = uuidParam.safeParse(Astro.params.id);
const [row] = id.success ? await db.select().from(venues).where(eq(venues.id, id.data)).limit(1) : [];
if (!row) {
  return new Response('Venue not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
}

const [editor] = row.updatedBy
  ? await db.select({ name: user.name, email: user.email }).from(user).where(eq(user.id, row.updatedBy)).limit(1)
  : [];
const venue = serializeVenue(row);
const hidden = hiddenReason(row);
const HIDDEN_TEXT = {
  no_tier: 'Hidden from the public site: no approved tier yet.',
  needs_location: 'Hidden from the public site: needs a location.',
  closed: 'Hidden from the public site: permanently closed. Only Gone But Not Forgotten venues stay listed once closed.',
};
const currentUserId = Astro.locals.user!.id;
const [visitStatus, inspectionHistory, pendingProposal, verifiedInspection, activeAdmins] = await Promise.all([
  getVisitStatus(db, row.id, currentUserId),
  listConfirmedInspections(db, row.id),
  pendingProposalForVenue(db, row.id),
  latestVerifiedInspection(db, row.id),
  countActiveAdmins(db),
]);
const verifiedInspectionText = verifiedInspection
  ? `${formatDate(verifiedInspection.inspectionDate)}, ${describeInspection(verifiedInspection).toLowerCase()}`
  : null;
const [closer] = row.closedBy
  ? await db.select({ name: user.name, email: user.email }).from(user).where(eq(user.id, row.closedBy)).limit(1)
  : [];
---

<AdminLayout title={`Edit ${row.name}`}>
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8a5100]">Venue management</p>
        <h1 class="mt-2 text-3xl font-bold text-[#1a1e24]">{row.name}</h1>
      </div>
      <div class="flex gap-2">
        {!hidden && (
          <a href={`/venues/${row.slug}`} class="rounded-lg border border-[#d9cfb8] bg-white px-4 py-2.5 text-sm font-semibold text-[#1a1e24] hover:bg-[#f5efe5]">View public page</a>
        )}
        <a href={`/admin/venues/${row.id}/history`} class="rounded-lg border border-[#d9cfb8] bg-white px-4 py-2.5 text-sm font-semibold text-[#1a1e24] hover:bg-[#f5efe5]">History</a>
      </div>
    </div>

    {row.closedAt && (
      <div role="status" class="rounded-xl border-2 border-stone-400 bg-stone-100 px-4 py-3 text-sm text-stone-800">
        <strong class="block uppercase tracking-wider">Permanently closed</strong>
        Marked closed on {formatDate(row.closedAt)}{closer ? ` by ${closer.name || closer.email}` : ''}. Off the map and Near Me
        {row.tier === 'gone_but_not_forgotten' ? '; still listed under Gone But Not Forgotten.' : '; hidden from the public site.'}
      </div>
    )}

    {hidden && hidden !== 'closed' && (
      <p role="status" class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">{HIDDEN_TEXT[hidden]}</p>
    )}

    <VenueClosure client:load venueId={row.id} venueName={row.name} closed={Boolean(row.closedAt)} isGoneButNotForgotten={row.tier === 'gone_but_not_forgotten'} />

    <TierProposalPanel
      client:load
      venueId={row.id}
      currentTier={row.tier}
      pending={pendingProposal ? serializeProposal(pendingProposal) : null}
      currentUserId={currentUserId}
      latestVerifiedInspection={verifiedInspectionText}
      activeAdmins={activeAdmins}
    />

    <VisitedToday client:load venueId={row.id} initialStatus={visitStatus} />

    <section class="rounded-2xl border border-[#d9cfb8] bg-[#f9f7f1] p-5 shadow-sm" aria-labelledby="inspection-history-heading">
      <h2 id="inspection-history-heading" class="text-lg font-bold text-[#1a1e24]">Inspection history</h2>
      {inspectionHistory.length === 0 ? (
        <p class="mt-2 text-sm text-[#535353]">No confirmed inspections yet.</p>
      ) : (
        <ul class="mt-3 divide-y divide-[#eadfca] text-sm">
          {inspectionHistory.map((inspection) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 py-2">
              <span class="font-semibold text-[#1a1e24]">{formatDate(inspection.inspectionDate)}</span>
              <span class={inspection.kind === 'legacy' ? 'text-[#535353] italic' : 'text-emerald-800'}>{describeInspection(inspection)}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <VenueForm
      client:load
      mode="edit"
      venue={venue}
      updatedByName={editor?.name || editor?.email || null}
      uploadsEnabled={Boolean(getBlobToken())}
    />
  </div>
</AdminLayout>
