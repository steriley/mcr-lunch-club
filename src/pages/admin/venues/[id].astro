---
import { eq } from 'drizzle-orm';
import VenueForm from '@/components/admin/VenueForm.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { user } from '@/db/auth-schema';
import { venues } from '@/db/schema';
import { uuidParam } from '@/lib/admin-api';
import { formatDate } from '@/lib/dates';
import { db } from '@/lib/db';
import { getPublicMapApiKey, isBlobConfigured } from '@/lib/env';
import { describeInspection, getVisitStatus, latestVerifiedInspection } from '@/lib/inspections';
import {
  countActiveAdmins,
  pendingProposalForVenue,
  serializeProposal,
} from '@/lib/tier-proposals';
import { loadVenueTimeline } from '@/lib/venue-history';
import { listVenueImages, serializeVenueImage } from '@/lib/venue-images';
import { serializeVenue } from '@/lib/venues';

export const prerender = false;

const id = uuidParam.safeParse(Astro.params.id);
const [row] = id.success
  ? await db.select().from(venues).where(eq(venues.id, id.data)).limit(1)
  : [];
if (!row) {
  return new Response('Venue not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
}

const currentUser = Astro.locals.user!;
const nameOf = async (userId: string | null) => {
  if (!userId) return null;
  const [found] = await db
    .select({ name: user.name, email: user.email })
    .from(user)
    .where(eq(user.id, userId))
    .limit(1);
  return found ? found.name || found.email : null;
};

const [
  editorName,
  closerName,
  visitStatus,
  timeline,
  pendingProposal,
  verifiedInspection,
  activeAdmins,
  images,
] = await Promise.all([
  nameOf(row.updatedBy),
  nameOf(row.closedBy),
  getVisitStatus(db, row.id, currentUser.id),
  loadVenueTimeline(db, row.id),
  pendingProposalForVenue(db, row.id),
  latestVerifiedInspection(db, row.id),
  countActiveAdmins(db),
  listVenueImages(db, row.id),
]);

const closedText = row.closedAt
  ? `Permanently closed: marked on ${formatDate(row.closedAt)}${closerName ? ` by ${closerName}` : ''}. Off the map and Near Me${
      row.tier === 'gone_but_not_forgotten'
        ? '; still listed under Gone But Not Forgotten.'
        : '; hidden from the public site.'
    }`
  : null;

const dossier = {
  currentTier: row.tier,
  currentUserId: currentUser.id,
  currentUserName: currentUser.name || currentUser.email,
  visitStatus,
  latestVerifiedInspection: verifiedInspection
    ? `${formatDate(verifiedInspection.inspectionDate)}, ${describeInspection(verifiedInspection).replace(/^V/, 'v')}`
    : null,
  pendingMotion: pendingProposal ? serializeProposal(pendingProposal) : null,
  activeAdmins,
  closed: row.closedAt !== null,
  closedText,
  timeline: timeline.map(({ id, kind, when, text, note }) => ({
    id,
    kind,
    when,
    text,
    ...(note ? { note } : {}),
  })),
};
---

<AdminLayout title={`Edit ${row.name}`}>
  <VenueForm
    client:load
    mode="edit"
    venue={serializeVenue(row)}
    updatedByName={editorName}
    uploadsEnabled={isBlobConfigured()}
    images={images.map(serializeVenueImage)}
    dossier={dossier}
    mapApiKey={getPublicMapApiKey()}
  />
</AdminLayout>
