---
import VenueForm from '@/components/admin/VenueForm.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { uuidParam } from '@/lib/admin-api';
import { loadVenueDossier } from '@/lib/admin-read-models';
import { db } from '@/lib/db';
import { getPublicMapApiKey, isBlobConfigured } from '@/lib/env';

export const prerender = false;

const id = uuidParam.safeParse(Astro.params.id);
const page = id.success ? await loadVenueDossier(db, id.data, Astro.locals.user!) : null;
if (!page) {
  return new Response('Venue not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
}
---

<AdminLayout title={`Edit ${page.venue.name}`}>
  <VenueForm
    client:load
    mode="edit"
    venue={page.venue}
    updatedByName={page.updatedByName}
    uploadsEnabled={isBlobConfigured()}
    images={page.images}
    dossier={page.dossier}
    mapApiKey={getPublicMapApiKey()}
  />
</AdminLayout>
