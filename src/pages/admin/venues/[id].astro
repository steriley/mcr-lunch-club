---
import { eq } from 'drizzle-orm';
import VenueForm from '@/components/islands/VenueForm.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db, schema } from '@/lib/db';

const user = Astro.locals.user;
const { venues } = schema;

if (!user || user.role !== 'admin') {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const venue = await db.query.venues.findFirst({ where: eq(venues.id, Astro.params.id ?? '') });
if (!venue) {
  throw new Error('Venue not found');
}
---

<AdminLayout title="Edit venue — Chairs' Area" userName={user?.name ?? 'Chair'}>
  <div class="space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8a5100]">Venue management</p>
        <h1 class="mt-2 text-3xl font-bold text-[#1a1e24]">Edit venue</h1>
      </div>
      <a href="/admin/venues" class="rounded-lg border border-[#d9cfb8] bg-white px-4 py-2.5 text-sm font-semibold text-[#1a1e24] hover:bg-[#f5efe5]">
        Back to list
      </a>
    </div>

    <VenueForm client:load mode="edit" :venue={JSON.stringify(venue)} />
  </div>
</AdminLayout>
