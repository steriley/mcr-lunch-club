---
import AdminLayout from '@/layouts/AdminLayout.astro';
import VenueForm from '@/components/admin/VenueForm.vue';
import { uuidParam } from '@/lib/admin-api';
import { loadSuggestionPrefill } from '@/lib/admin-read-models';
import { db } from '@/lib/db';
import { getPublicMapApiKey } from '@/lib/env';

export const prerender = false;

// ?fromSuggestion=<id>: accept a member's suggestion through this form.
const requested = Astro.url.searchParams.get('fromSuggestion');
const suggestionId = requested ? uuidParam.safeParse(requested) : null;
const prefill = suggestionId?.success ? await loadSuggestionPrefill(db, suggestionId.data) : null;
---

<AdminLayout title={prefill ? 'Accept suggestion' : 'New venue'}>
  {requested && !prefill && (
    <p
      role="alert"
      class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"
    >
      That suggestion has already been accepted or dismissed, or no longer exists.{' '}
      <a href="/admin/suggestions" class="font-semibold underline">
        Back to suggestions
      </a>
    </p>
  )}

  <VenueForm client:load mode="create" suggestion={prefill} mapApiKey={getPublicMapApiKey()} />
</AdminLayout>
