---
import AdminLayout from '@/layouts/AdminLayout.astro';
import VenueForm from '@/components/islands/VenueForm.vue';
import { getBlobToken } from '@/lib/env';

export const prerender = false;
---

<AdminLayout title="New venue">
  <div class="space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8a5100]">Venue management</p>
        <h1 class="mt-2 text-3xl font-bold text-[#1a1e24]">Create a venue</h1>
      </div>
    </div>

    <VenueForm client:load mode="create" uploadsEnabled={Boolean(getBlobToken())} />
  </div>
</AdminLayout>
