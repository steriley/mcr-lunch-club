---
import SuggestionInbox from '@/components/admin/SuggestionInbox.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { loadSuggestions } from '@/lib/admin-read-models';
import { db } from '@/lib/db';
import { SUGGESTION_STATUSES, type SuggestionStatus } from '@/lib/suggestion-schema';

export const prerender = false;

const requested = Astro.url.searchParams.get('status');
const status: SuggestionStatus = SUGGESTION_STATUSES.includes(requested as SuggestionStatus)
  ? (requested as SuggestionStatus)
  : 'new';

const { suggestions, totals } = await loadSuggestions(db, status);
const tabs = [
  { status: 'new', label: 'Inbox' },
  { status: 'accepted', label: 'Accepted' },
  { status: 'dismissed', label: 'Dismissed' },
].map((tab) => ({
  ...tab,
  total: totals.get(tab.status as SuggestionStatus) ?? 0,
  active: tab.status === status,
}));
---

<AdminLayout title="Suggestions">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Member petitions</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">Venue suggestions</h1>
      <p class="mt-2 max-w-2xl text-sm text-soot">
        Sent from the public “Suggest a Venue” form. Nothing here appears on the site. Accepting one
        opens the new-venue form; saving it creates a hidden venue with a To Be Assessed proposal
        that a different Chair must approve.
      </p>
    </div>

    <nav class="flex flex-wrap gap-2" aria-label="Suggestion status">
      {tabs.map((tab) => (
        <a
          href={
            tab.status === 'new' ? '/admin/suggestions' : `/admin/suggestions?status=${tab.status}`
          }
          class:list={[
            'rounded-full border px-3 py-1.5 text-sm font-semibold',
            tab.active
              ? 'border-navy bg-navy-fixed text-white'
              : 'border-hairline bg-surface text-ink hover:bg-linen',
          ]}
          aria-current={tab.active ? 'page' : undefined}
        >
          {tab.label} <span class="ml-1 opacity-75">{tab.total}</span>
        </a>
      ))}
    </nav>

    <SuggestionInbox client:load suggestions={suggestions} />
  </div>
</AdminLayout>
