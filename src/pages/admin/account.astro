---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ChangePasswordForm from '@/components/admin/ChangePasswordForm.vue';
import NotificationSettings from '@/components/admin/NotificationSettings.vue';
import PasskeySettings from '@/components/admin/PasskeySettings.vue';
import SessionControls from '@/components/admin/SessionControls.vue';
import { db } from '@/lib/db';
import { getPasskeyEnvironment, getPushEnvironment } from '@/lib/env';
import { getPreferences, listDevices } from '@/lib/push/store';

export const prerender = false;

const user = Astro.locals.user;
// Without VAPID keys push is off, and its settings are not shown (#115).
const pushKey = getPushEnvironment()?.publicKey ?? null;
const [preferences, devices] =
  user && pushKey
    ? await Promise.all([getPreferences(db, user.id), listDevices(db, user.id)])
    : [null, []];
const { host: passkeyHost } = getPasskeyEnvironment();
---

<AdminLayout title="Account">
  <div class="mx-auto flex max-w-2xl flex-col gap-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Account</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">Personal settings</h1>
      <p class="mt-3 text-sm text-soot">
        Signed in as <strong>{user?.email}</strong>.
      </p>
    </div>

    {pushKey && preferences && (
      <NotificationSettings
        client:load
        publicKey={pushKey}
        initialPreferences={{
          proposals: preferences.proposals,
          decisions: preferences.decisions,
          visits: preferences.visits,
          suggestions: preferences.suggestions,
        }}
        initialDevices={devices}
      />
    )}
    <PasskeySettings client:load passkeyHost={passkeyHost} />
    <ChangePasswordForm client:load />
    <SessionControls client:load />
  </div>
</AdminLayout>
