---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ChangePasswordForm from '@/components/admin/ChangePasswordForm.vue';
import SessionControls from '@/components/admin/SessionControls.vue';

export const prerender = false;

const user = Astro.locals.user;
---

<AdminLayout title="Account">
  <div class="mx-auto max-w-2xl space-y-6">
    <div class="rounded-2xl border border-hairline bg-parchment p-6 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Account</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">Personal settings</h1>
      <p class="mt-3 text-sm text-soot">
        Signed in as <strong>{user?.email}</strong>.
      </p>
    </div>

    <ChangePasswordForm client:load />
    <SessionControls client:load />
  </div>
</AdminLayout>
