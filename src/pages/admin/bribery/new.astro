---
import { asc } from 'drizzle-orm';
import BriberyForm from '@/components/admin/BriberyForm.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { venues } from '@/db/schema';
import { db } from '@/lib/db';

export const prerender = false;

const venueOptions = await db
  .select({ id: venues.id, name: venues.name })
  .from(venues)
  .orderBy(asc(venues.name));
---

<AdminLayout title="New bribery record">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Hall of Shame</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">New record</h1>
    </div>

    <BriberyForm client:load mode="create" venues={venueOptions} />
  </div>
</AdminLayout>
