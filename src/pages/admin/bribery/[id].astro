---
import BriberyForm from '@/components/admin/BriberyForm.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { uuidParam } from '@/lib/admin-api';
import { loadBriberyRecord, loadVenueOptions } from '@/lib/admin-read-models';
import { db } from '@/lib/db';

export const prerender = false;

const id = uuidParam.safeParse(Astro.params.id);
const record = id.success ? await loadBriberyRecord(db, id.data) : null;
if (!record) {
  return new Response('Bribery record not found', {
    status: 404,
    headers: { 'Cache-Control': 'no-store' },
  });
}

const venueOptions = await loadVenueOptions(db);
---

<AdminLayout title="Edit bribery record">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Hall of Shame</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">{record.title || 'Edit record'}</h1>
    </div>

    <BriberyForm client:load mode="edit" record={record} venues={venueOptions} />
  </div>
</AdminLayout>
