---
import { asc, eq } from 'drizzle-orm';
import BriberyForm from '@/components/islands/BriberyForm.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { briberyRecords, venues } from '@/db/schema';
import { uuidParam } from '@/lib/admin-api';
import { serializeBribery } from '@/lib/bribery';
import { db } from '@/lib/db';

export const prerender = false;

const id = uuidParam.safeParse(Astro.params.id);
const [record] = id.success ? await db.select().from(briberyRecords).where(eq(briberyRecords.id, id.data)).limit(1) : [];
if (!record) {
  return new Response('Bribery record not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
}

const venueOptions = await db.select({ id: venues.id, name: venues.name }).from(venues).orderBy(asc(venues.name));
---

<AdminLayout title="Edit bribery record">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#8a5100]">Hall of Shame</p>
      <h1 class="mt-2 text-3xl font-bold text-[#1a1e24]">{record.title || 'Edit record'}</h1>
    </div>

    <BriberyForm client:load mode="edit" record={serializeBribery(record)} venues={venueOptions} />
  </div>
</AdminLayout>
