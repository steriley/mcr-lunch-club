---
import GoldenCutEditor from '@/components/admin/GoldenCutEditor.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { loadGoldenCutEditor } from '@/lib/admin-read-models';
import { db } from '@/lib/db';
import { GOLDEN_CUT_SIZE } from '@/lib/golden-cut-schema';

export const prerender = false;

const { entries, approvedVenues } = await loadGoldenCutEditor(db);
---

<AdminLayout title="The Golden Cut">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Home page showcase</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">The Golden Cut</h1>
      <p class="mt-2 max-w-3xl text-sm text-graphite">
        Up to {GOLDEN_CUT_SIZE} Approved venues in heavy rotation, shown at the top of the home
        page. Position #01 gets the hero card and its puff piece in full; #02 to #05 show a short
        hook. Drag to reorder (or use the arrows), then save. Any Chair can change it; no
        countersign.
      </p>
    </div>

    <GoldenCutEditor client:load entries={entries} approvedVenues={approvedVenues} />
  </div>
</AdminLayout>
