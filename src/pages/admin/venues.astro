---
import { asc } from 'drizzle-orm';
import AdminLayout from '@/layouts/AdminLayout.astro';
import VenueTable from '@/components/admin/VenueTable.vue';
import { venues } from '@/db/schema';
import { db } from '@/lib/db';
import { routeStatus } from '@/lib/route-status';
import { hiddenReason } from '@/lib/visibility';

export const prerender = false;

const rows = await db
  .select({
    id: venues.id,
    name: venues.name,
    slug: venues.slug,
    tier: venues.tier,
    latitude: venues.latitude,
    longitude: venues.longitude,
    distanceMiles: venues.distanceMiles,
    closedAt: venues.closedAt,
    lastInspectionDate: venues.lastInspectionDate,
    walkingTimeMin: venues.walkingTimeMin,
    routeUpdatedAt: venues.routeUpdatedAt,
    updatedAt: venues.updatedAt,
  })
  .from(venues)
  .orderBy(asc(venues.name));
const tableRows = rows.map(({ latitude, longitude, distanceMiles, walkingTimeMin, routeUpdatedAt, closedAt, ...venue }) => ({
  ...venue,
  hiddenReason: hiddenReason({ tier: venue.tier, latitude, longitude, closedAt }),
  closed: closedAt !== null,
  routeStatus: routeStatus({ latitude, longitude, distanceMiles, walkingTimeMin, routeUpdatedAt }),
  updatedAt: venue.updatedAt.toISOString(),
}));
---

<AdminLayout title="Venues">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Venue management</p>
        <h1 class="mt-2 text-3xl font-bold text-ink">Venue ledger</h1>
      </div>
      <a href="/admin/venues/new" class="inline-flex items-center justify-center rounded-lg bg-navy-fixed px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-deep">
        New venue
      </a>
    </div>

    <VenueTable client:load venues={tableRows} />
  </div>
</AdminLayout>
