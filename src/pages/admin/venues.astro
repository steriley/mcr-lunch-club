---
import AdminLayout from '@/layouts/AdminLayout.astro';
import VenueTable from '@/components/admin/VenueTable.vue';
import { loadVenueList } from '@/lib/admin-read-models';
import { db } from '@/lib/db';

export const prerender = false;

const tableRows = await loadVenueList(db);
---

<AdminLayout title="Venues">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Venue management</p>
        <h1 class="mt-2 text-3xl font-bold text-ink">Venue ledger</h1>
      </div>
      <a
        href="/admin/venues/new"
        class="inline-flex items-center justify-center rounded-lg bg-navy-fixed px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-deep"
      >
        New venue
      </a>
    </div>

    <VenueTable client:load venues={tableRows} />
  </div>
</AdminLayout>
