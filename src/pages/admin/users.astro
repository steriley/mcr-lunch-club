---
import UserManagement from '@/components/islands/UserManagement.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { auth } from '@/lib/auth';

export const prerender = false;

const currentUser = Astro.locals.user!;
const { users: entries } = await auth.api.listUsers({
  headers: Astro.request.headers,
  query: { limit: 200, sortBy: 'createdAt', sortDirection: 'desc' },
});
const users = entries.map((entry) => ({
  id: entry.id,
  email: entry.email,
  name: entry.name,
  role: entry.role ?? 'user',
  banned: Boolean(entry.banned),
  createdAt: entry.createdAt ? new Date(entry.createdAt).toISOString() : null,
}));
---

<AdminLayout title="Users">
  <div class="space-y-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Chair management</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">Users</h1>
    </div>

    <UserManagement client:load users={users} currentUserId={currentUser.id} />
  </div>
</AdminLayout>
