---
import { desc } from 'drizzle-orm';
import BriberyTable from '@/components/admin/BriberyTable.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { briberyRecords } from '@/db/schema';
import { db } from '@/lib/db';

export const prerender = false;

const records = await db
  .select({
    id: briberyRecords.id,
    title: briberyRecords.title,
    venueNameText: briberyRecords.venueNameText,
    incidentDate: briberyRecords.incidentDate,
    description: briberyRecords.description,
    published: briberyRecords.published,
  })
  .from(briberyRecords)
  .orderBy(desc(briberyRecords.incidentDate), desc(briberyRecords.createdAt));
---

<AdminLayout title="Bribery Record">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Hall of Shame</p>
        <h1 class="mt-2 text-3xl font-bold text-ink">Bribery / Improper Benefit Attempt Record</h1>
      </div>
      <a
        href="/admin/bribery/new"
        class="inline-flex items-center justify-center rounded-lg bg-navy-fixed px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-deep"
      >
        New record
      </a>
    </div>

    <BriberyTable client:load records={records} />
  </div>
</AdminLayout>
