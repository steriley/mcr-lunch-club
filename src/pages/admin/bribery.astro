---
import BriberyTable from '@/components/admin/BriberyTable.vue';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { loadBriberyRecords } from '@/lib/admin-read-models';
import { db } from '@/lib/db';

export const prerender = false;

const records = await loadBriberyRecords(db);
---

<AdminLayout title="Bribery Records">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-ochre">Hall of Shame</p>
        <h1 class="mt-2 text-3xl font-bold text-ink">Bribery Records</h1>
      </div>
      <a
        href="/admin/bribery/new"
        class="inline-flex items-center justify-center rounded-lg bg-navy-fixed px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-deep"
      >
        New record
      </a>
    </div>

    <BriberyTable client:load records={records} />
  </div>
</AdminLayout>
