---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';

// Shown by the service worker (src/sw/sw.ts) when a page is not saved on this device and there is no connection.
export const prerender = true;
---

<Layout title="Offline — MCR Lunch Club" noindex>
  <div class="max-w-xl mx-auto px-4 py-16 sm:py-24 w-full flex flex-col items-center text-center space-y-5">
    <Icon name="plate" class="icon-hero text-navy" />
    <p class="text-xs font-bold uppercase tracking-widest text-navy font-sans">
      No connection · Not on file
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold text-ink">This page isn’t saved on this device</h1>
    <p class="text-base text-stone-600 font-sans">
      The Ledger needs a signal to fetch it. These pages are kept for when you have none.
    </p>
    <div class="flex flex-wrap justify-center gap-3 pt-2 font-sans text-sm">
      <a
        href="/"
        class="rounded-lg bg-navy-fixed px-4 py-2.5 font-semibold text-white hover:bg-deep"
      >
        The map
      </a>
      <a
        href="/#near-me"
        class="rounded-lg border border-hairline bg-surface px-4 py-2.5 font-semibold text-ink hover:bg-stone-50"
      >
        Near Me
      </a>
      <a
        href="/verdicts/approved"
        class="rounded-lg border border-hairline bg-surface px-4 py-2.5 font-semibold text-ink hover:bg-stone-50"
      >
        The verdicts
      </a>
    </div>
  </div>
</Layout>
