---
import '@/styles/global.css';
import inspectionsData from '@/data/inspections.json';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "MCR Lunch Club — We Return Only Where Deserved",
  description = "A map of Manchester where every pin is a verdict. Formal, a bit pompous, and actually useful at 12:25.",
  noindex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const inspectionCount = inspectionsData.length;
const currentYear = new Date().getFullYear();
const navigation = [
  { href: '/manifesto', label: 'The Manifesto', icon: '📜' },
  { href: '/tiers/approved', label: 'Tiers', icon: '🏅' },
  { href: '/inspections', label: 'Inspections', icon: '▤' },
];
---

<!doctype html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FBF6EA" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MCR Lunch Club" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class="min-h-screen flex flex-col text-[#1e1b17] bg-[#FBF6EA] antialiased selection:bg-[#1B2F6B] selection:text-white">
    <header class="site-header sticky top-0 z-50">
      <div class="site-header-inner">
        <a href="/" class="brand-lockup" aria-label="MCR Lunch Club home">
          <img src="/brand/logo.png" alt="" class="brand-crest" />
          <span class="brand-copy">
            <span class="brand-name">MCR LUNCH CLUB</span>
            <span class="brand-caption">WE RETURN ONLY WHERE DESERVED</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main navigation">
          {navigation.map((item) => {
            const active = item.href === '/tiers/approved'
              ? currentPath.startsWith('/tiers')
              : currentPath === item.href;
            return (
              <a
                href={item.href}
                class:list={['site-nav-link', active && 'is-active']}
                aria-current={active ? 'page' : undefined}
              >
                <span aria-hidden="true">{item.icon}</span>
                <span>{item.label}</span>
                {item.label === 'Inspections' && <span class="nav-count">{inspectionCount}</span>}
              </a>
            );
          })}
        </nav>

        <a href="/#where-to-today" class="header-lunch-link" data-open-where-today>
          <span aria-hidden="true">◉</span>
          <span>Where to today?</span>
          <span class="header-time">12:25</span>
        </a>

        <details class="mobile-menu">
          <summary class="mobile-menu-trigger" aria-label="Menu">
            <span class="mobile-menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          </summary>
          <div class="mobile-menu-panel">
            <a href="/#where-to-today" class="header-lunch-link" data-open-where-today>
              <span aria-hidden="true">◉</span>
              <span>Where to today?</span>
              <span class="header-time">12:25</span>
            </a>
            <nav class="site-nav" aria-label="Mobile navigation">
              {navigation.map((item) => {
                const active = item.href === '/tiers/approved'
                  ? currentPath.startsWith('/tiers')
                  : currentPath === item.href;
                return (
                  <a
                    href={item.href}
                    class:list={['site-nav-link', active && 'is-active']}
                    aria-current={active ? 'page' : undefined}
                  >
                    <span aria-hidden="true">{item.icon}</span>
                    <span>{item.label}</span>
                    {item.label === 'Inspections' && <span class="nav-count">{inspectionCount}</span>}
                  </a>
                );
              })}
            </nav>
          </div>
        </details>
      </div>
    </header>

    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-column footer-editorial">
          <div class="footer-column-title">
            <span class="footer-column-icon" aria-hidden="true">⚖</span>
            <span>The Sovereign Committee of the Manchester Lunch Club</span>
          </div>
          <p class="footer-creed">“We lunch with purpose. We judge with integrity. We return only where deserved.”</p>
          <p class="footer-detail">
            Independent venues first. Two separate satisfactory inspections required for Approved status.
            Extravagance without merit will not pass inspection.
          </p>
        </div>

        <div class="footer-column footer-jurisdiction">
          <span class="footer-section-title">Jurisdictional Scope &amp; Currency Key</span>
          <div class="footer-fact">
            <span class="footer-fact-icon" aria-hidden="true">⌖</span>
            <span>Jurisdiction: Central Manchester · 2.5 Miles from Base at Spinningfields Crown Square.</span>
          </div>
          <div class="footer-fact">
            <span class="footer-fact-icon" aria-hidden="true">£</span>
            <span><strong>Cost Key:</strong> £ (under £10) · ££ (above £10) · £££ (payday treat)</span>
          </div>
          <div class="footer-fact">
            <span class="footer-fact-icon" aria-hidden="true">✓</span>
            <span>No right of appeal is recognized. All decisions of the Chairs are final.</span>
          </div>
        </div>

        <div class="footer-column footer-codex">
          <span class="footer-section-title">Tribunal Codex</span>
          <div class="footer-links">
            <a href="/manifesto"><span aria-hidden="true">▤</span>The Manifesto</a>
            <a href="/hall-of-shame"><span aria-hidden="true">⚖</span>Bribery Register</a>
            <a href="/#suggest-a-venue"><span aria-hidden="true">＋</span>Suggest a Venue</a>
            <a href="/manifesto"><span aria-hidden="true">▣</span>Chairs' Code of Conduct</a>
          </div>
        </div>

        <div class="footer-legal">
          <span>© {currentYear} The High Tribunal of MCR Lunch Club. Recorded at Spinningfields, Manchester. All official decrees gazetted. v1.0</span>
          <span>Transcripts entered in perpetuity under the Crown Square Accord.</span>
          <span>
            Walking times and distances from Base:
            © <a href="https://openrouteservice.org/" rel="noopener noreferrer">openrouteservice.org</a> by HeiGIT |
            Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer">OpenStreetMap</a> contributors
          </span>
        </div>
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) {
            menu.open = false;
          }
        });
      });
    </script>
  </body>
</html>
