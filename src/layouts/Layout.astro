---
import Icon from '@/components/Icon.astro';
import SiteNav, { type NavItem } from '@/components/SiteNav.astro';
import '@/styles/global.css';
import Fonts from '@/components/Fonts.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import WebAnalytics from '@/components/WebAnalytics.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Snow from '@/components/Snow.astro';
import PwaStatus from '@/components/PwaStatus.vue';
import InstallApp from '@/components/InstallApp.vue';
import StandaloneBack from '@/components/StandaloneBack.astro';
import { BUILT_AT } from '@/lib/build-time';
import {
  countPublicInspections,
  countPublicInspectionsForBuild,
  countPublicVenues,
  countPublicVenuesForBuild,
} from '@/lib/public-data';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Social card image, absolute or site-relative; defaults to the club card. */
  image?: string;
}

const {
  title = 'MCR Lunch Club — We Return Only Where Deserved',
  description = 'A map of Manchester where every pin is a verdict. Formal, a bit pompous, and actually useful at 11:59.',
  noindex = false,
  image = '/brand/og-default.png',
} = Astro.props;

// Shared links (Slack, WhatsApp) show these; prerendered pages resolve them against `site`.
const siteUrl = Astro.site ?? Astro.url;
// Prerendered paths end in a slash; the site links without one, so the canonical does too.
const canonicalPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;

const currentPath = Astro.url.pathname;
// The badge is decoration: a database hiccup must not take down every page (the 404 page included).
// Prerendered pages share one count per build; the sign-in page renders on demand and counts afresh.
const inspectionCount = await (
  Astro.isPrerendered ? countPublicInspectionsForBuild() : countPublicInspections()
).catch(() => null);
const venueCount = await (
  Astro.isPrerendered ? countPublicVenuesForBuild() : countPublicVenues()
).catch(() => null);
const currentYear = new Date().getFullYear();
const navigation: NavItem[] = [
  { href: '/manifesto', label: 'The Manifesto', icon: 'history_edu' },
  { href: '/verdicts/approved', label: 'Verdicts', icon: 'military_tech' },
  { href: '/inspections', label: 'Inspections', icon: 'fact_check' },
  { href: '/#where-to-today', label: 'Where to today?', icon: 'restaurant', opensWhereToday: true },
];
const navCounts = { '/inspections': inspectionCount, '/verdicts/approved': venueCount };
---

<!doctype html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ThemeScript />
    {!noindex && <WebAnalytics />}
    <Fonts />
    <link rel="icon" type="image/png" href="/brand/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="MCR Lunch Club" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="mcr-built-at" content={BUILT_AT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MCR Lunch Club" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col text-ink bg-parchment antialiased selection:bg-navy-fixed selection:text-white">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <PwaStatus client:load />
    <header class="site-header sticky top-0 z-50">
      <div class="site-header-inner">
        <a href="/" class="brand-lockup" aria-label="MCR Lunch Club home">
          <img src="/brand/logo-96.webp" width="96" height="96" alt="" class="brand-crest" />
          <span class="brand-copy">
            <span class="brand-name">MCR LUNCH CLUB</span>
            <span class="brand-caption">WE RETURN ONLY WHERE DESERVED</span>
          </span>
        </a>

        <SiteNav
          items={navigation}
          currentPath={currentPath}
          counts={navCounts}
          ariaLabel="Main navigation"
        />

        <details class="mobile-menu">
          <summary class="mobile-menu-trigger" aria-label="Menu">
            <span class="mobile-menu-bars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </summary>
          <div class="mobile-menu-panel">
            <SiteNav
              items={navigation}
              currentPath={currentPath}
              counts={navCounts}
              ariaLabel="Mobile navigation"
            />
          </div>
        </details>
      </div>
    </header>

    <Snow />
    <StandaloneBack hidden={currentPath === '/'} />

    <main id="main" tabindex="-1" class="flex-1 flex flex-col outline-none">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-column footer-editorial">
          <div class="footer-column-title">
            <Icon name="scales" class="footer-column-icon" />
            <span>The Sovereign Committee of the Manchester Lunch Club</span>
          </div>
          <p class="footer-creed">
            “We lunch with purpose. We judge with integrity. We return only where deserved.”
          </p>
          <p class="footer-detail">
            Independent venues first. Two separate satisfactory inspections required for Approved
            status. Extravagance without merit will not pass inspection.
          </p>
        </div>

        <div class="footer-column footer-codex">
          <span class="footer-section-title">The Usher’s Desk</span>
          <div class="footer-codex-row">
            <div class="footer-links">
              <a href="/hall-of-shame">
                <Icon name="scales" />
                Bribery Register
              </a>
              <a href="/#suggest-a-venue">
                <span aria-hidden="true">＋</span>Suggest a Venue
              </a>
              <a href="/faqs">
                <Icon name="scroll" />
                FAQs
              </a>
              <InstallApp client:idle />
            </div>
            <ThemeToggle class="footer-theme-toggle" />
          </div>
        </div>

        <div class="footer-legal">
          <span>
            © {currentYear} The High Tribunal of MCR Lunch Club.
            <span class="footer-legal-extra"> Recorded at Spinningfields, Manchester.</span>
          </span>
          <span>
            Routes ©{' '}
            <a href="https://openrouteservice.org/" target="_blank" rel="noopener noreferrer">
              openrouteservice
            </a>{' '}
            · Data ©{' '}
            <a
              href="https://www.openstreetmap.org/copyright"
              target="_blank"
              rel="noopener noreferrer"
            >
              OpenStreetMap
            </a>
          </span>
        </div>
      </div>
    </footer>
    <script>
      import '@/pwa/register';
    </script>
    <script>
      import { getDrivingDirectionsUrl, getWalkingDirectionsUrl } from '@/lib/map/directions';

      // Pages ship Google directions; Apple devices get Apple Maps, like the Near Me walk button.
      const urlFor = {
        'data-walk-directions': getWalkingDirectionsUrl,
        'data-drive-directions': getDrivingDirectionsUrl,
      };
      for (const [attribute, directionsUrl] of Object.entries(urlFor)) {
        document.querySelectorAll<HTMLAnchorElement>(`a[${attribute}]`).forEach((link) => {
          const lat = Number(link.dataset.lat);
          const lng = Number(link.dataset.lng);
          if (Number.isFinite(lat) && Number.isFinite(lng)) link.href = directionsUrl(lat, lng);
        });
      }
    </script>
    <script>
      // <details> flips to display:none the moment it closes, so keep it [open] while the
      // panel fades out and slides in/out with the .is-open class.
      const CLOSE_MS = 180;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        const openMenu = () => {
          clearTimeout(closeTimer);
          menu.open = true;
          // Paint the closed state first so the transition has somewhere to start from.
          void menu.offsetWidth;
          menu.classList.add('is-open');
        };

        const closeMenu = () => {
          menu.classList.remove('is-open');
          clearTimeout(closeTimer);
          closeTimer = setTimeout(
            () => {
              menu.open = false;
            },
            reducedMotion.matches ? 0 : CLOSE_MS
          );
        };

        menu.querySelector('summary')?.addEventListener('click', (event) => {
          event.preventDefault();
          if (menu.classList.contains('is-open')) closeMenu();
          else openMenu();
        });

        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) closeMenu();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.classList.contains('is-open')) {
            closeMenu();
            menu.querySelector('summary')?.focus();
          }
        });
      });
    </script>
  </body>
</html>
