---
import '@/styles/admin.css';
import Fonts from '@/components/Fonts.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import AdminUserMenu from '@/components/admin/AdminUserMenu.vue';
import { ADMIN_AREA_NAME, ADMIN_NAV } from '@/lib/admin-config';

interface Props {
  /** Page name; the area name is appended automatically. */
  title?: string;
}

const { title } = Astro.props;
// The photo uploader encodes WebP with WebAssembly (src/lib/optimise-image.ts).
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource("'wasm-unsafe-eval'");
const user = Astro.locals.user;
const pageTitle = title ? `${title} — ${ADMIN_AREA_NAME}` : ADMIN_AREA_NAME;
const currentPath = Astro.url.pathname;
const navItems = ADMIN_NAV.map((item) => ({
  ...item,
  active:
    currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(`${item.href}`)),
}));
---

<!doctype html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeScript />
    <Fonts />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/brand/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-chairs.png" />
    <meta name="apple-mobile-web-app-title" content="MCR Chairs" />
    <title>{pageTitle} | MCR Lunch Club</title>
  </head>
  <body class="min-h-screen bg-parchment text-ink antialiased">
    <a
      href="#admin-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-navy focus:shadow"
    >
      Skip to content
    </a>
    <header class="border-b border-hairline bg-parchment shadow-sm">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a
          href="/"
          class="flex items-center gap-3 text-ink no-underline"
          aria-label="MCR Lunch Club home"
        >
          <img
            src="/brand/logo-96.webp"
            width="96"
            height="96"
            alt=""
            class="h-11 w-11 object-contain"
          />
          <div>
            <div class="font-serif text-lg font-bold uppercase tracking-[0.08em]">
              MCR LUNCH CLUB
            </div>
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-ochre">
              {ADMIN_AREA_NAME}
            </div>
          </div>
        </a>

        <nav
          class="hidden items-center gap-2 rounded-full border border-hairline bg-card p-1 lg:flex"
          aria-label={`${ADMIN_AREA_NAME} navigation`}
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-3 py-2 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-navy',
                item.active ? 'bg-surface text-navy' : 'text-ink hover:bg-cream',
              ]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <AdminUserMenu client:load userName={user?.name || user?.email || 'Chair'} />
      </div>

      <nav class="border-t border-sand lg:hidden" aria-label={`${ADMIN_AREA_NAME} navigation`}>
        <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 py-2 sm:px-6">
          {navItems.map((item) => (
            <li class="shrink-0">
              <a
                href={item.href}
                class:list={[
                  'block rounded-full px-3 py-1.5 text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-navy',
                  item.active ? 'bg-surface text-navy shadow-sm' : 'text-ink hover:bg-card',
                ]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="admin-main" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="admin-footer">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8">
        <span>MCR Lunch Club · {ADMIN_AREA_NAME}</span>
        <ThemeToggle />
      </div>
    </footer>
    <script>
      import { config } from 'zod';

      // The forms validate with Zod, which otherwise probes for eval support and
      // trips the Content-Security-Policy; it validates the same without it.
      config({ jitless: true });
    </script>
  </body>
</html>
