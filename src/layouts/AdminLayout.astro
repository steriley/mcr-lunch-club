---
import '@/styles/global.css';
import AdminUserMenu from '@/components/islands/AdminUserMenu.vue';
import { ADMIN_AREA_NAME, ADMIN_NAV } from '@/lib/admin-config';

interface Props {
  /** Page name; the area name is appended automatically. */
  title?: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const pageTitle = title ? `${title} — ${ADMIN_AREA_NAME}` : ADMIN_AREA_NAME;
const currentPath = Astro.url.pathname;
const navItems = ADMIN_NAV.map((item) => ({
  ...item,
  active: currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(`${item.href}`)),
}));
---

<!doctype html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MCR Chairs" />
    <title>{pageTitle} | MCR Lunch Club</title>
  </head>
  <body class="min-h-screen bg-[#FBF6EA] text-[#1e1b17] antialiased">
    <a href="#admin-main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#1B2F6B] focus:shadow">
      Skip to content
    </a>
    <header class="border-b border-[#d9cfb8] bg-[#FBF6EA] shadow-sm">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3 text-[#1a1e24] no-underline" aria-label="MCR Lunch Club home">
          <img src="/brand/logo.png" alt="" class="h-11 w-11 object-contain" />
          <div>
            <div class="font-serif text-lg font-bold uppercase tracking-[0.08em]">MCR LUNCH CLUB</div>
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8a5100]">{ADMIN_AREA_NAME}</div>
          </div>
        </a>

        <nav class="hidden items-center gap-2 rounded-full border border-[#d9cfb8] bg-[#f3ecdb] p-1 lg:flex" aria-label={`${ADMIN_AREA_NAME} navigation`}>
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={['rounded-full px-3 py-2 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1B2F6B]', item.active ? 'bg-white text-[#1B2F6B]' : 'text-[#1a1e24] hover:bg-[#f9f7f1]']}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <AdminUserMenu client:load userName={user?.name || user?.email || 'Chair'} />
      </div>

      <nav class="border-t border-[#eadfca] lg:hidden" aria-label={`${ADMIN_AREA_NAME} navigation`}>
        <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 py-2 sm:px-6">
          {navItems.map((item) => (
            <li class="shrink-0">
              <a
                href={item.href}
                class:list={['block rounded-full px-3 py-1.5 text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1B2F6B]', item.active ? 'bg-white text-[#1B2F6B] shadow-sm' : 'text-[#1a1e24] hover:bg-[#f3ecdb]']}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="admin-main" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </body>
</html>
