---
import '@/styles/admin.css';
import Fonts from '@/components/Fonts.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import PwaStatus from '@/components/PwaStatus.vue';
import StandaloneBack from '@/components/StandaloneBack.astro';
import AdminMobileMenu from '@/components/admin/AdminMobileMenu.vue';
import AdminUserMenu from '@/components/admin/AdminUserMenu.vue';
import PublishBar from '@/components/admin/PublishBar.vue';
import { ADMIN_AREA_NAME, ADMIN_NAV } from '@/lib/admin-config';
import { db } from '@/lib/db';
import { getPushEnvironment } from '@/lib/env';
import { getPublishStatus } from '@/lib/publishing';

interface Props {
  /** Page name; the area name is appended automatically. */
  title?: string;
}

const { title } = Astro.props;
// The photo uploader encodes WebP with WebAssembly (src/lib/optimise-image.ts).
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource("'wasm-unsafe-eval'");
const user = Astro.locals.user;
// The sign-in page has no signed-in Chair and nothing to publish.
const publishStatus = user
  ? await getPublishStatus(db).catch((error) => {
      console.error(
        '[admin] could not read the publish status:',
        error instanceof Error ? error.message : error
      );
      return null;
    })
  : null;
// Chairs' push notifications (#115): the key this device subscribes with, when they are set up.
const pushKey = user ? (getPushEnvironment()?.publicKey ?? null) : null;
const pageTitle = title ? `${title} — ${ADMIN_AREA_NAME}` : ADMIN_AREA_NAME;
const currentPath = Astro.url.pathname;
const navItems = ADMIN_NAV.map((item) => ({
  ...item,
  active:
    currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(`${item.href}`)),
}));
---

<!doctype html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeScript />
    <Fonts />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/brand/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-chairs.png" />
    <meta name="apple-mobile-web-app-title" content="MCR Chairs" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    {pushKey && <meta name="mcr-push-key" content={pushKey} />}
    <title>{pageTitle} | MCR Lunch Club</title>
    <!-- In the head, ahead of every island: Zod's jitless setting must be in place before any form builds a schema. -->
    <script>
      import { config } from 'zod';

      // The forms validate with Zod, which otherwise probes for eval support and
      // trips the Content-Security-Policy; it validates the same without it.
      config({ jitless: true });
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-parchment text-ink antialiased">
    <a
      href="#admin-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-navy focus:shadow"
    >
      Skip to content
    </a>
    <PwaStatus client:load chairsArea />
    {publishStatus && <PublishBar client:load initial={publishStatus} />}
    <header class="admin-header relative">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/admin" class="brand-lockup" aria-label="MCR Lunch Club Chairs' Area home">
          <img src="/brand/logo-96.webp" width="96" height="96" alt="" class="brand-crest" />
          <span class="brand-copy">
            <span class="brand-name">MCR LUNCH CLUB</span>
            <span class="brand-caption">{ADMIN_AREA_NAME.toUpperCase()}</span>
          </span>
        </a>

        <nav
          class="hidden items-center gap-2 rounded-full border border-hairline bg-card p-1 lg:flex"
          aria-label={`${ADMIN_AREA_NAME} navigation`}
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-3 py-2 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-navy',
                item.active ? 'bg-surface text-navy' : 'text-ink hover:bg-cream',
              ]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="hidden lg:block">
          <AdminUserMenu client:load userName={user?.name || user?.email || 'Chair'} />
        </div>
        <AdminMobileMenu
          client:load
          items={navItems}
          userName={user?.name || user?.email || 'Chair'}
          ariaLabel={`${ADMIN_AREA_NAME} navigation`}
        />
      </div>
    </header>

    <StandaloneBack hidden={currentPath === '/admin'} />

    <main id="admin-main" class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="admin-footer">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8">
        <span>MCR Lunch Club · {ADMIN_AREA_NAME}</span>
        <ThemeToggle />
      </div>
    </footer>
    <script>
      import '@/pwa/register';
      import '@/pwa/push-sync';
    </script>
  </body>
</html>
