---
import '@/styles/global.css';
import AdminUserMenu from '@/components/islands/AdminUserMenu.vue';

interface Props {
  title?: string;
  userName?: string;
}

const { title = "Chairs' Area", userName = 'Chair' } = Astro.props;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/venues', label: 'Venues' },
  { href: '/admin/bribery', label: 'Bribery Records' },
  { href: '/admin/users', label: 'Users' },
  { href: '/admin/account', label: 'Account' },
];
---

<!doctype html>
<html lang="en" class="min-h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#FBF6EA] text-[#1e1b17] antialiased">
    <header class="border-b border-[#d9cfb8] bg-[#FBF6EA] shadow-sm">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3 text-[#1a1e24] no-underline" aria-label="MCR Lunch Club home">
          <img src="/brand/logo.png" alt="" class="h-11 w-11 object-contain" />
          <div>
            <div class="font-serif text-lg font-bold uppercase tracking-[0.08em]">MCR LUNCH CLUB</div>
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8a5100]">Chairs' Area</div>
          </div>
        </a>

        <nav class="hidden items-center gap-2 rounded-full border border-[#d9cfb8] bg-[#f3ecdb] p-1 md:flex" aria-label="Admin navigation">
          {navItems.map((item) => {
            const active = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class:list={['rounded-full px-3 py-2 text-sm font-semibold transition', active && 'bg-white text-[#1B2F6B]', !active && 'text-[#1a1e24] hover:bg-[#f9f7f1]']}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <AdminUserMenu client:load userName={userName} />
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </body>
</html>
