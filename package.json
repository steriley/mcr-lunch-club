{
  "name": "mcr-lunch-club",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && vue-tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"src/test/**\" --test-coverage-exclude=\"**/*.json\" \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:migrate:deploy": "tsx ./scripts/migrate-deploy.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx ./scripts/seed-chair.ts",
    "auth:generate": "pnpm dlx auth@1.7.10 generate --config src/lib/auth.ts --output src/db/auth-schema.ts",
    "db:local": "bash scripts/db-local.sh",
    "serve:build": "tsx ./scripts/serve-build.ts",
    "db:import": "tsx ./scripts/import-existing-content.ts",
    "check:security": "tsx ./scripts/check-admin-security.ts",
    "check:built": "playwright test",
    "check:bundle": "tsx ./scripts/check-client-bundle.ts",
    "routes:backfill": "tsx ./scripts/backfill-routes.ts",
    "inspections:import-legacy": "tsx ./scripts/import-legacy-inspections.ts",
    "venues:backfill-audit-trail": "tsx ./scripts/backfill-audit-trail.ts",
    "test:db": "tsx ./scripts/test-db.ts",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.15",
    "@astrojs/vue": "^7.1.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@better-fetch/fetch": "1.3.2",
    "@jsquash/webp": "^1.5.0",
    "@nanostores/vue": "^1.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.2",
    "astro": "^7.4.0",
    "better-auth": "^1.7.10",
    "better-call": "1.4.2",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "nanostores": "^1.0.0",
    "pg": "^8.23.1",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "wawoff2": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "2.2.10"
  }
}
